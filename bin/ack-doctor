#!/usr/bin/env bash
# ack-doctor: read-only check of this machine. Prints name<TAB>status<TAB>detail,
# status ok|missing|warn|info. Exit 0 when no required line is missing, 1 when one
# is, 2 when the install is broken (the share directory next to bin/ is missing).
# It creates, changes and deletes nothing and starts no proxy.

# Git for Windows may hand over a backslash path (bash 'D:\x\ack-doctor').
_slashes() { case "$OSTYPE" in msys*|cygwin*) REPLY="${1//\\//}" ;; *) REPLY="$1" ;; esac; }
_slashes "${BASH_SOURCE[0]}"; _self="$REPLY"
while [ -L "$_self" ]; do
  _slashes "$(readlink "$_self")"; _t="$REPLY"
  case "$_t" in
    /*) _self="$_t" ;;
    *) case "$_self" in */*) _self="${_self%/*}/$_t" ;; *) _self="./$_t" ;; esac ;;
  esac
done
case "$_self" in */*) _dir="${_self%/*}" ;; *) _dir="." ;; esac
if ! SHARE="$(cd "$_dir/../share" 2>/dev/null && pwd)"; then
  echo "ack-doctor: cannot find the share directory next to bin/." >&2
  echo "ack-doctor: reinstall agent-construction-kit." >&2
  exit 2
fi
BINDIR="$(cd "$_dir" && pwd)"
# shellcheck source=../share/lib.sh
. "$SHARE/lib.sh" || exit 2
ack_paths

TAB=$'\t'
RC=0
NOASK="could not ask claude"
AGAIN="; run the check again"

# emit NAME STATUS DETAIL [required]: one line; tabs and newlines in DETAIL become spaces.
emit() {
  local d="$3"
  d="${d//$'\t'/ }"; d="${d//$'\r'/}"; d="${d//$'\n'/ }"
  printf '%s\t%s\t%s\n' "$1" "$2" "$d"
  [ "${4:-}" = required ] && [ "$2" = missing ] && RC=1
  return 0
}

# url_host URL -> REPLY: host without scheme, credentials, port, path
url_host() {
  local h="$1"
  case "$h" in *://*) h="${h#*://}" ;; esac
  h="${h##*@}"
  h="${h%%[/?#]*}"
  case "$h" in
    '['*) h="${h%%]*}]" ;;
    *) h="${h%%:*}" ;;
  esac
  REPLY="$h"
}

# plugin_state NAME -> PSTATE: enabled | disabled | absent (from PLUGIN_OBJS).
# A plugin counts as enabled if any entry (one per scope) is enabled.
plugin_state() {
  local name="$1" obj seen=0 on=0
  PSTATE=absent
  while IFS= read -r obj; do
    case "$obj" in *',"id":"'"$name"'@'*) ;; *) continue ;; esac
    seen=1
    case "$obj" in *',"enabled":true,'*) on=1 ;; esac
  done <<EOT
$PLUGIN_OBJS
EOT
  if [ "$on" = 1 ]; then PSTATE=enabled; elif [ "$seen" = 1 ]; then PSTATE=disabled; fi
  return 0
}

# ---------------------------------------------------------------- platform
os="${ACK_UNAME:-$(uname -s)}"
case "$os" in
  Linux) emit platform ok "linux $(uname -m)" ;;
  Darwin) emit platform ok "macos $(uname -m)" ;;
  MINGW*|MSYS*|CYGWIN*)
    if w="$(cygpath -w "$BASH" 2>/dev/null)" && [ -n "$w" ]; then emit platform ok "windows $w"
    else emit platform ok "windows $BASH"; fi ;;
  *) emit platform warn "unknown system $os; the kit supports linux, macos and windows" ;;
esac

# ---------------------------------------------------------------- wrapper-dir
if out="$(bash "$BINDIR/ack-wrappers" dir 2>/dev/null)" && [ -n "$out" ]; then
  IFS="$TAB" read -r _k st dd <<EOT
${out%%$'\n'*}
EOT
  dd="${dd//$'\r'/}"
  if [ "$st" = ok ]; then emit wrapper-dir ok "$dd"
  else emit wrapper-dir warn "$dd is not on PATH; the setup can add it to PATH"; fi
else
  emit wrapper-dir warn "could not ask ack-wrappers; check that bin/ack-wrappers is intact"
fi

# ---------------------------------------------------------------- claude, git
CLAUDE="" CLAUDE_OK=1
if CLAUDE="$(ack_find_claude)"; then
  ack_run_bounded 15 "$CLAUDE" --version; vrc=$?
  if [ "$vrc" = 124 ]; then
    emit claude warn "$CLAUDE did not answer --version within 15 s; run it by hand to see why"
    CLAUDE_OK=0
  elif [ "$vrc" = 0 ] && [ -n "$ACK_BOUNDED_OUT" ]; then
    v="${ACK_BOUNDED_OUT%%$'\n'*}"
    emit claude ok "$CLAUDE ($v)" required
  else
    emit claude warn "$CLAUDE did not answer --version; run it by hand to see why"
  fi
else
  CLAUDE=""
  emit claude missing "claude is not installed or not on PATH; install Claude Code and run this again" required
fi

if gitbin="$(type -P git 2>/dev/null)" && [ -n "$gitbin" ]; then
  if gv="$("$gitbin" --version 2>/dev/null)" && [ -n "$gv" ]; then emit git ok "$gitbin ($gv)" required
  else emit git warn "$gitbin did not answer --version"; fi
else
  gitbin=""
  emit git missing "git is not installed or not on PATH; install git and run this again" required
fi

# ---------------------------------------------------------------- node, python
# Not needed for the starters, needed to build and run an agent team: skilletor's launcher
# wants Node.js 18+, the briefing hook is a Python 3 script. Looked up the way the
# launchers do: node, and python3 (on Windows python3.exe, python.exe, then py -3). A Windows
# Store stub exists but prints no version, so only an answer to --version counts.
case "$OSTYPE" in msys*|cygwin*) WINDOWS=1 ;; *) WINDOWS=0 ;; esac

nodebin=""
if nodebin="$(type -P node 2>/dev/null)" && [ -n "$nodebin" ] &&
   ack_run_bounded 15 "$nodebin" --version && [ -n "$ACK_BOUNDED_OUT" ]; then
  nv="${ACK_BOUNDED_OUT%%$'\n'*}"; nv="${nv//$'\r'/}"
  nmajor="${nv#v}"; nmajor="${nmajor%%.*}"
  case "$nmajor" in
    ''|*[!0-9]*) emit runtime:node warn "$nodebin printed '$nv' as its version; skilletor needs Node.js 18 or newer" ;;
    *)
      if [ "$nmajor" -ge 18 ]; then emit runtime:node ok "$nodebin ($nv)"
      else emit runtime:node warn "$nodebin is Node.js $nv, and skilletor needs 18 or newer. Update it: Windows: winget upgrade OpenJS.NodeJS.LTS; macOS: brew upgrade node; Linux: your package manager"
      fi ;;
  esac
else
  emit runtime:node warn "Node.js is not installed or not on PATH, and building and running an agent team needs it (skilletor). Install it: Windows: winget install OpenJS.NodeJS.LTS; macOS: brew install node; Linux: your package manager, for example sudo apt install nodejs"
fi

pybin="" pv=""
for cand in python3 python py; do
  [ "$cand" = python3 ] || [ "$WINDOWS" = 1 ] || continue
  b="$(type -P "$cand" 2>/dev/null)" && [ -n "$b" ] || continue
  if [ "$cand" = py ]; then ack_run_bounded 15 "$b" -3 --version; else ack_run_bounded 15 "$b" --version; fi
  pyrc=$?
  out="${ACK_BOUNDED_OUT%%$'\n'*}"; out="${out//$'\r'/}"
  case "$out" in
    'Python 3'*) if [ "$pyrc" = 0 ]; then pybin="$b"; pv="$out"; break; fi ;;
  esac
done
if [ -n "$pybin" ]; then
  emit runtime:python ok "$pybin ($pv)"
else
  emit runtime:python warn "Python 3 is not installed or not on PATH, and building and running an agent team needs it (the briefing hook is a Python script). Install it: Windows: winget install Python.Python.3.12 (the Microsoft Store stub does not count); macOS: brew install python; Linux: your package manager, for example sudo apt install python3"
fi

# ---------------------------------------------------------------- repo
if [ -z "$gitbin" ]; then
  emit repo info "git is not available"
elif [ "$("$gitbin" rev-parse --is-inside-work-tree 2>/dev/null)" = true ]; then
  remotes=""
  while IFS= read -r line; do
    line="${line//$'\r'/}"
    case "$line" in *"(fetch)") ;; *) continue ;; esac
    line="${line%" (fetch)"}"
    rn="${line%%[[:space:]]*}"
    ru="${line#"$rn"}"; _ack_trim "$ru"; ru="$REPLY"
    ack_strip_url "$ru"
    remotes="${remotes:+$remotes, }$rn $REPLY"
  done <<EOT
$("$gitbin" remote -v 2>/dev/null)
EOT
  if [ -n "$remotes" ]; then emit repo ok "$remotes"; else emit repo info "no remote"; fi
else
  emit repo info "the current directory is not inside a git work tree"
fi

# ---------------------------------------------------------------- session-model
model="${ANTHROPIC_MODEL:-}"
host=""
if [ -n "${ANTHROPIC_BASE_URL:-}" ]; then url_host "$ANTHROPIC_BASE_URL"; host="$REPLY"; fi
detail="${model:-default}"
[ -n "$host" ] && detail="$detail via $host"
emit session-model info "$detail"

# ---------------------------------------------------------------- marketplace, plugins
MARKETS="" PLUGIN_OBJS="" ASKED_M=0 ASKED_P=0
if [ -n "$CLAUDE" ] && [ "$CLAUDE_OK" = 1 ]; then
  if ack_run_bounded 15 "$CLAUDE" plugin marketplace list; then
    ASKED_M=1
    while IFS= read -r line; do
      line="${line//$'\r'/}"
      case "$line" in *"❯"*) ;; *) continue ;; esac
      line="${line#*❯}"; _ack_trim "$line"
      MARKETS="$MARKETS ${REPLY%%[[:space:]]*}"
    done <<EOT
$ACK_BOUNDED_OUT
EOT
  fi
  if ack_run_bounded 15 "$CLAUDE" plugin list --json; then
    ASKED_P=1
    json_objects "$ACK_BOUNDED_OUT"
  fi
fi

if [ "$ASKED_M" = 1 ]; then
  case "$MARKETS " in
    *" getty "*) emit marketplace:getty ok "marketplace getty is configured" required ;;
    *) emit marketplace:getty missing "marketplace getty is not configured; run: claude plugin marketplace add Getty/marketplace" required ;;
  esac
else
  emit marketplace:getty warn "$NOASK, so this required line is not counted as missing$AGAIN"
fi

plugin_line() { # NAME required|optional
  local n="$1"
  if [ "$ASKED_P" != 1 ]; then
    if [ "$2" = required ]; then emit "plugin:$n" warn "$NOASK, so this required line is not counted as missing$AGAIN"
    else emit "plugin:$n" warn "$NOASK$AGAIN"; fi
    return 0
  fi
  plugin_state "$n"
  case "$PSTATE" in
    enabled) emit "plugin:$n" ok "$n is installed and enabled" ;;
    disabled) emit "plugin:$n" warn "$n is installed but disabled; run: claude plugin enable $n" ;;
    *) if [ "$2" = required ]; then
         emit "plugin:$n" missing "$n is not installed; run: claude plugin install $n@getty" required
       else emit "plugin:$n" missing "$n is not installed (optional)"; fi ;;
  esac
}
plugin_line briefing required
plugin_line skilletor required
plugin_line superpowers optional
plugin_line mattpocock-skills optional

# ---------------------------------------------------------------- tools
tool_line() { # NAME MISSING-DETAIL MISSING-STATUS
  local p
  if p="$(type -P "$1" 2>/dev/null)" && [ -n "$p" ]; then emit "tool:$1" ok "$p"
  else emit "tool:$1" "$3" "$2"; fi
}
tool_line karr "not installed (optional)" info
if ack_find_proxy; then
  if [ "$ACK_PROXY_ONPATH" = 1 ]; then emit tool:claude-code-proxy ok "$REPLY"
  else emit tool:claude-code-proxy ok "$REPLY (not on PATH)"; fi
else emit tool:claude-code-proxy info "not installed (optional)"; fi
tool_line uvx "needed only for the MiniMax MCP server" info
tool_line curl "not installed; the proxy check and the local-model probe need it" warn

# ---------------------------------------------------------------- kit-data
# install leaves a checksum of the plugin's share/ in the copy the starters run
if [ -r "$ACK_DATA_DIR/VERSION" ]; then
  have=""
  [ -r "$ACK_DATA_DIR/.ack-sum" ] && IFS= read -r have < "$ACK_DATA_DIR/.ack-sum"
  if [ "$(cd "$ACK_DATA_DIR" && pwd -P)" = "$(cd "$SHARE" && pwd -P)" ]; then
    emit kit-data ok "the plugin's own files in $ACK_DATA_DIR"
  elif ack_share_sum "$SHARE" && [ "$have" = "$REPLY" ]; then
    emit kit-data ok "up to date in $ACK_DATA_DIR"
  else
    emit kit-data warn "the starters' copy in $ACK_DATA_DIR is older than the plugin; the setup can refresh it"
  fi
else
  emit kit-data info "not installed in $ACK_DATA_DIR; ack-wrappers install creates it"
fi

# ---------------------------------------------------------------- wrappers
if out="$(bash "$BINDIR/ack-wrappers" list 2>/dev/null)"; then
  while IFS="$TAB" read -r n st perm path _rest; do
    path="${path//$'\r'/}"
    case "$st" in
      installed) emit "wrapper:$n" ok "$path (permissions $perm)" ;;
      foreign) emit "wrapper:$n" info "$path (not made by this kit)" ;;
    esac
  done <<EOT
$out
EOT
else
  emit wrapper:list warn "could not ask ack-wrappers; check that bin/ack-wrappers is intact"
fi

exit "$RC"
