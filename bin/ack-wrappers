#!/usr/bin/env bash
# ack-wrappers: install and manage the claude_with_<provider> wrappers.
#   ack-wrappers list [--dir DIR]
#   ack-wrappers install <provider|danger> [--permissions ask|allow|skip] [--dir DIR] [--replace]
#   ack-wrappers uninstall <provider|danger> [--dir DIR]
#   ack-wrappers path-fix [--dir DIR]
#   ack-wrappers dir [--dir DIR]
#   ack-wrappers key-template <provider>      ack-wrappers key-edit <provider>
#   ack-wrappers set <provider> KEY=VALUE...
#   ack-wrappers test <provider|danger> [--dir DIR]
#   ack-wrappers probe-local
#   ack-wrappers new-local <name> --url URL --model MODEL [--context N] [--key-var VAR] [--thinking N] [--replace]
# Exit codes: 0 ok, 1 test found a problem, 2 usage error or unknown provider,
# 3 a foreign file sits at the target (nothing changed).
# install prints a final "path" line when the target directory is not on PATH:
# "path<TAB>missing<TAB>DIR" (run path-fix), or "path<TAB>pending<TAB>DIR" when
# path-fix already added it to the shell profile (active in new terminals).

# Git for Windows may hand over a backslash path (bash 'D:\x\ack-wrappers').
_slashes() { case "$OSTYPE" in msys*|cygwin*) REPLY="${1//\\//}" ;; *) REPLY="$1" ;; esac; }
_slashes "${BASH_SOURCE[0]}"; _self="$REPLY"
while [ -L "$_self" ]; do
  _slashes "$(readlink "$_self")"; _t="$REPLY"
  case "$_t" in
    /*) _self="$_t" ;;
    *) case "$_self" in */*) _self="${_self%/*}/$_t" ;; *) _self="./$_t" ;; esac ;;
  esac
done
case "$_self" in */*) _dir="${_self%/*}" ;; *) _dir="." ;; esac
if ! SHARE="$(cd "$_dir/../share" 2>/dev/null && pwd)"; then
  echo "ack-wrappers: cannot find the share directory next to bin/." >&2
  echo "ack-wrappers: reinstall agent-construction-kit." >&2
  exit 2
fi
# shellcheck source=../share/lib.sh
. "$SHARE/lib.sh" || exit 2
ack_paths

MARK="agent-construction-kit wrapper v1"
PROMPT="Reply with the single word OK"
TAB=$'\t'
TMP="" CHILD=""
trap '[ -n "$TMP" ] && rm -rf "$TMP"' EXIT
# a signal (a caller's timeout, Ctrl-C) also stops the claude that test started
_on_signal() {
  [ -n "$CHILD" ] && kill "$CHILD" 2>/dev/null
  [ -n "$TMP" ] && rm -rf "$TMP"
  TMP=""; exit "$1"
}
trap '_on_signal 130' INT
trap '_on_signal 143' TERM
trap '_on_signal 129' HUP

# ---------------------------------------------------------------- helpers

# _help: the header comment (line 2 up to the first line that is not a comment)
_help() {
  local n=0 line
  while IFS= read -r line; do
    n=$((n + 1))
    [ "$n" -ge 2 ] || continue
    case "$line" in '#'*) line="${line#\#}"; printf '%s\n' "${line# }" ;; *) break ;; esac
  done < "${BASH_SOURCE[0]}"
}

usage_err() {
  echo "ack-wrappers: $1" >&2
  echo "ack-wrappers: usage: ack-wrappers list|install|uninstall|path-fix|dir|key-template|key-edit|set|test|probe-local|new-local (see the header of $0)." >&2
  exit 2
}
_is_windows() { case "$OSTYPE" in msys*|cygwin*) return 0 ;; esac; return 1; }
# _posix PATH -> REPLY in the form bash understands (C:\x -> /c/x on Windows)
_posix() {
  REPLY="$1"
  if _is_windows; then
    case "$REPLY" in [A-Za-z]:*) REPLY="$(cygpath -u "$REPLY")" ;; esac
    _slashes "$REPLY"
  fi
}
# _absdir DIR -> REPLY (logical absolute path of an existing directory)
_absdir() { REPLY="$(cd "$1" 2>/dev/null && pwd)"; }
# _abspath PATH -> REPLY (also for directories that do not exist yet)
_abspath() {
  local p="$1"
  while [ "${p%/}" != "$p" ] && [ -n "${p%/}" ]; do p="${p%/}"; done
  # a folder that cannot be entered keeps its written form
  if [ -d "$p" ] && _absdir "$p" && [ -n "$REPLY" ]; then return 0; fi
  case "$p" in /*|[A-Za-z]:*) REPLY="$p" ;; *) REPLY="$PWD/$p" ;; esac
}
# _norm DIR -> REPLY: form for comparing PATH entries
_norm() {
  local d="$1" p
  while [ "${d%/}" != "$d" ] && [ -n "${d%/}" ]; do d="${d%/}"; done
  if [ -d "$d" ] && p="$(cd "$d" 2>/dev/null && pwd -P)"; then d="$p"; fi
  if _is_windows; then d="$(printf '%s' "$d" | tr 'A-Z' 'a-z')"; fi
  REPLY="$d"
}
_dir_on_path() {
  local want e paths="$PATH"
  _norm "$1"; want="$REPLY"
  local IFS=:
  for e in $paths; do
    [ -n "$e" ] || continue
    _norm "$e"
    [ "$REPLY" = "$want" ] && return 0
  done
  return 1
}
# _dq STRING -> REPLY escaped for use inside double quotes
_dq() { REPLY="$(printf '%s' "$1" | sed -e 's/[\\"$`]/\\&/g')"; }

# _check_hash KEY VALUE: the loader cuts a line at whitespace followed by '#'
_check_hash() {
  case "$2" in *[[:space:]]'#'*) usage_err "the value of $1 contains whitespace followed by '#', where the loader cuts the line." ;; esac
}

ALLOWED=""
_parse() {
  OPT_PERM="" OPT_DIR="" OPT_REPLACE=0 OPT_URL="" OPT_MODEL="" OPT_CONTEXT="" OPT_THINKING="" OPT_KEYVAR="" ARGS=()
  local opt val
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; while [ $# -gt 0 ]; do ARGS+=("$1"); shift; done; break ;;
      --*)
        opt="${1%%=*}"
        case " $ALLOWED " in *" $opt "*) ;; *) usage_err "unknown option '$opt' for this subcommand." ;; esac
        if [ "$opt" = --replace ]; then OPT_REPLACE=1; shift; continue; fi
        case "$1" in
          *=*) val="${1#*=}"; shift ;;
          *) [ $# -ge 2 ] || usage_err "$opt needs a value."; val="$2"; shift 2 ;;
        esac
        [ -n "$val" ] || usage_err "$opt needs a non-empty value."
        case "$opt" in
          --dir) OPT_DIR="$val" ;;
          --url) OPT_URL="$val" ;;
          --model) OPT_MODEL="$val" ;;
          --context) OPT_CONTEXT="$val" ;;
          --thinking) OPT_THINKING="$val" ;;
          --key-var) OPT_KEYVAR="$val" ;;
          *) OPT_PERM="$val" ;;
        esac ;;
      *) ARGS+=("$1"); shift ;;
    esac
  done
}
_need_names() { # COUNT_MIN
  [ "${#ARGS[@]}" -ge "$1" ] || usage_err "missing argument (a provider name)."
}
_valid_name() {
  case "$1" in ''|*[!a-z0-9_-]*|-*) usage_err "'$1' is not a valid provider name (a-z, 0-9, - and _)." ;; esac
}
# _select NAME -> loads the provider (or danger); sets PERM, PROV, DESC
_select() {
  local name="$1"
  if [ "$name" = danger ]; then
    case "$OPT_PERM" in ''|skip) PERM=skip ;; *) usage_err "danger only takes --permissions skip." ;; esac
    PROV=none; DESC="Claude Code with every permission prompt skipped, no other provider"
    return 0
  fi
  ack_provider_load "$name" "$SHARE" || exit 2
  PERM="${OPT_PERM:-ask}"; PROV="$name"; DESC="$ACK_C_DESCRIPTION"
  case "$PERM" in ask|allow|skip) ;; *) usage_err "'$PERM' is not a permission mode (ask, allow or skip)." ;; esac
}

# _vm_dir DIR: a folder of a version manager, which its next upgrade leaves off PATH
_vm_dir() {
  case "$1/" in */.nvm/*|*/.volta/*|*/.asdf/*|*/.fnm/*|*/node_modules/*|*/versions/*) return 0 ;; esac
  return 1
}
# directory of the first claude_with_* (not .bak/.cmd) found on PATH, outside a
# version manager's folders
_first_wrapper_dir() {
  local d f n paths="$PATH"
  local IFS=:
  for d in $paths; do
    [ -n "$d" ] && [ -d "$d" ] && [ -w "$d" ] || continue
    _vm_dir "$d" && continue
    for f in "$d"/claude_with_*; do
      { [ -e "$f" ] || [ -L "$f" ]; } || continue
      n="${f##*/}"; case "$n" in *.*) continue ;; esac
      _absdir "$d"; return 0
    done
  done
  return 1
}
_scan_path_for() { # FILENAME
  local d paths="$PATH"
  local IFS=:
  for d in $paths; do
    [ -n "$d" ] && [ -d "$d" ] || continue
    if [ -e "$d/$1" ] || [ -L "$d/$1" ]; then _absdir "$d"; return 0; fi
  done
  return 1
}
# _target_dir -> TARGET: --dir, dir of the first claude_with_* on PATH, dir of claude
# when that is ~/bin (writable), else $HOME/.local/bin. Creates nothing. Any other
# folder of claude may belong to a version manager or a package and vanish with it.
_target_dir() {
  local claude cdir cphys h
  if [ -n "$OPT_DIR" ]; then _posix "$OPT_DIR"; _abspath "$REPLY"; TARGET="$REPLY"; return 0; fi
  if _first_wrapper_dir; then TARGET="$REPLY"; return 0; fi
  if claude="$(ack_find_claude)"; then
    case "$claude" in */*) cdir="${claude%/*}" ;; *) cdir="" ;; esac
    if [ -n "$cdir" ] && [ -d "$cdir" ] && [ -w "$cdir" ]; then
      _absdir "$cdir"; cdir="$REPLY"; cphys="$(cd "$cdir" 2>/dev/null && pwd -P)"
      for h in "$HOME/.local/bin" "$HOME/bin"; do
        [ -d "$h" ] || continue
        _absdir "$h"
        if [ "$cdir" = "$REPLY" ] || [ "$cphys" = "$(cd "$h" 2>/dev/null && pwd -P)" ]; then
          TARGET="$cdir"; return 0
        fi
      done
    fi
  fi
  TARGET="$HOME/.local/bin"
}
# where an existing wrapper NAME lives: --dir, else PATH, else the default target
_find_wrapper_dir() {
  if [ -z "$OPT_DIR" ] && _scan_path_for "claude_with_$1"; then TARGET="$REPLY"; return 0; fi
  _target_dir
}
# _squeeze PATH -> REPLY with every run of slashes collapsed to one
_squeeze() {
  local two='//' one='/'
  REPLY="$1"
  while case "$REPLY" in *//*) true ;; *) false ;; esac; do REPLY="${REPLY//$two/$one}"; done
}
_data_abs() { # -> DATA (absolute, bash form); refuses ".." components
  _posix "$ACK_DATA_DIR"
  case "/$REPLY/" in
    */../*)
      echo "ack-wrappers: ACK_DATA_DIR ($ACK_DATA_DIR) contains a '..' component." >&2
      echo "ack-wrappers: give an absolute path without '..', or unset ACK_DATA_DIR." >&2
      exit 2 ;;
  esac
  _abspath "$REPLY"; _squeeze "$REPLY"; DATA="$REPLY"
}

# _state FILE -> STATE absent|installed|foreign, STATE_PERM
_state() {
  local f="$1" l1 l2
  STATE_PERM="-"
  if [ -L "$f" ]; then STATE=foreign; return 0; fi
  if [ ! -e "$f" ]; then STATE=absent; return 0; fi
  if [ ! -f "$f" ]; then STATE=foreign; return 0; fi
  { IFS= read -r l1; IFS= read -r l2; } < "$f"
  l2="${l2//$'\r'/}"
  case "$l2" in
    "# $MARK"*|"rem $MARK"*)
      STATE=installed
      STATE_PERM="${l2#*permissions=}"; STATE_PERM="${STATE_PERM%% *}" ;;
    *) STATE=foreign ;;
  esac
}

_wrapper_text() { # name perm -> stdout
  local name="$1" perm="$2" prov="--provider $1 " mprov="$1"
  if [ "$name" = danger ]; then prov=""; mprov=none; fi
  _dq "$DATA"
  printf '#!/usr/bin/env bash\n# %s provider=%s permissions=%s\n' "$MARK" "$mprov" "$perm"
  printf 'exec "%s/claude-with" %s--permissions %s -- "$@"\n' "$REPLY" "$prov" "$perm"
}
_bash_windows() { # -> REPLY absolute Windows path of the running bash
  local w
  w="$(cygpath -w "$(type -P bash)")" || return 1
  case "$w" in
    *\\usr\\bin\\bash.exe)  # prefer Git's launcher, it sets up the PATH for scripts
      if [ -f "$(cygpath -u "${w%usr\\bin\\bash.exe}bin\\bash.exe")" ]; then w="${w%usr\\bin\\bash.exe}bin\\bash.exe"; fi ;;
  esac
  REPLY="$w"
}
_cmd_text() { # name perm bash_windows -> stdout (CRLF)
  local mprov="$1"; [ "$1" = danger ] && mprov=none
  printf '@"%s" "%%~dp0claude_with_%s" %%*\r\n' "$3" "$1"
  printf 'rem %s provider=%s permissions=%s\r\n' "$MARK" "$mprov" "$2"
}

# _foreign_note PATH -> REPLY: the path with its kind, size and date. Never its
# content: a hand-written starter often carries a key.
_foreign_note() {
  local p="$1" mode links uid gid size mon day tm
  if [ -L "$p" ]; then REPLY="$p (a symbolic link)"; return 0; fi
  if [ ! -f "$p" ]; then REPLY="$p (not a regular file)"; return 0; fi
  read -r mode links uid gid size mon day tm _ <<EOT
$(LC_ALL=C ls -ldn -- "$p" 2>/dev/null)
EOT
  case "$size" in ''|*[!0-9]*) REPLY="$p"; return 0 ;; esac
  REPLY="$p ($size bytes, last changed $mon $day $tm)"
}
# _show_foreign PATH: what is in the way: its path on stdout, its size and date on stderr
_show_foreign() {
  local p="$1"
  printf 'foreign%s%s\n' "$TAB" "$p"
  [ -L "$p" ] && printf 'symlink%s%s%s%s\n' "$TAB" "$p" "$TAB" "$(readlink "$p")"
  _foreign_note "$p"
  echo "ack-wrappers: $REPLY was not created by agent-construction-kit, so it was left alone." >&2
  return 0
}
_foreign_msg() {
  echo "ack-wrappers: $1 was not created by agent-construction-kit, so it was left alone." >&2
  echo "ack-wrappers: $2" >&2
}
_backup() { # PATH -> moves it to PATH.bak-YYYY-MM-DD[-N]
  local p="$1" b n=1 day
  day="$(date +%Y-%m-%d)"; b="$p.bak-$day"
  while [ -e "$b" ] || [ -L "$b" ]; do n=$((n + 1)); b="$p.bak-$day-$n"; done
  mv "$p" "$b" || return 1
  printf 'backup%s%s%s%s\n' "$TAB" "$p" "$TAB" "$b"
}

# _resolve PATH -> REPLY: the physical absolute form of PATH, also when its end does
# not exist yet: the deepest existing ancestor is resolved, the rest is appended with
# . and .. applied.
_resolve() {
  local p d out rest c
  _posix "$1"; _abspath "$REPLY"; _squeeze "$REPLY"; p="$REPLY"
  while [ "${p%/}" != "$p" ] && [ -n "${p%/}" ]; do p="${p%/}"; done
  d="$p"
  while [ ! -d "$d" ] && [ "$d" != / ]; do d="${d%/*}"; [ -n "$d" ] || d=/; done
  out="$(cd "$d" 2>/dev/null && pwd -P)" || out="$d"
  rest="${p#"$d"}"; rest="${rest#/}"
  while [ -n "$rest" ]; do
    case "$rest" in */*) c="${rest%%/*}"; rest="${rest#*/}" ;; *) c="$rest"; rest="" ;; esac
    case "$c" in
      ''|.) ;;
      ..) out="${out%/*}"; [ -n "$out" ] || out=/ ;;
      *) out="${out%/}/$c" ;;
    esac
  done
  _squeeze "$out"; REPLY="$out"
}
# _within A B: resolved path A is B or lies inside it
_within() { case "${1%/}/" in "${2%/}/"*) return 0 ;; esac; return 1; }

# _check_data: the data dir must be ours (marker), new or empty; never /, $HOME or above
# it, and apart from the config and state directories, whose files install would replace
_check_data() {
  local r h o which dir
  _resolve "$DATA"; r="$REPLY"
  _resolve "$HOME"; h="$REPLY"
  if _within "$h" "$r"; then
    echo "ack-wrappers: $DATA is your home directory or contains it, so it cannot be the data directory." >&2
    echo "ack-wrappers: unset ACK_DATA_DIR or point it at an empty folder of its own." >&2
    exit 2
  fi
  for which in config state; do
    if [ "$which" = config ]; then dir="$ACK_CONFIG_DIR"; else dir="$ACK_STATE_DIR"; fi
    _resolve "$dir"; o="$REPLY"
    if _within "$r" "$o" || _within "$o" "$r"; then
      echo "ack-wrappers: $DATA is, contains or lies inside the kit's $which directory $dir, so it cannot be the data directory." >&2
      echo "ack-wrappers: set ACK_DATA_DIR to a folder apart from ACK_CONFIG_DIR and ACK_STATE_DIR (or XDG_DATA_HOME apart from XDG_CONFIG_HOME and XDG_STATE_HOME)." >&2
      exit 2
    fi
  done
  if [ -e "$DATA" ]; then
    if [ ! -d "$DATA" ] || [ ! -r "$DATA" ] || [ ! -x "$DATA" ]; then
      echo "ack-wrappers: $DATA is not a readable directory, so it cannot be the data directory." >&2
      echo "ack-wrappers: point ACK_DATA_DIR at an empty or new folder, or fix its permissions." >&2
      exit 2
    fi
    if [ ! -f "$DATA/.ack-data" ] && [ -n "$(ls -A "$DATA" 2>/dev/null)" ]; then
      echo "ack-wrappers: $DATA exists, is not empty and was not made by agent-construction-kit." >&2
      echo "ack-wrappers: point ACK_DATA_DIR at an empty or new folder, or empty this one." >&2
      exit 2
    fi
  fi
}
# copy share/ to the data dir; drop providers/*.conf and *.mcp.json that no longer ship
_sync_share() {
  local f rel first
  mkdir -p "$DATA" || { echo "ack-wrappers: cannot create $DATA." >&2; echo "ack-wrappers: check its permissions or set ACK_DATA_DIR." >&2; exit 1; }
  [ "$(cd "$SHARE" && pwd -P)" = "$(cd "$DATA" && pwd -P)" ] && return 0
  printf 'agent-construction-kit data directory; the kit overwrites its files here\n' > "$DATA/.ack-data"
  if [ -d "$DATA/providers" ]; then
    for f in "$DATA"/providers/*.conf "$DATA"/providers/*.mcp.json; do
      [ -f "$f" ] && [ ! -e "$SHARE/providers/${f##*/}" ] && rm -f "$f"
    done
  fi
  cp -R "$SHARE"/. "$DATA"/ || { echo "ack-wrappers: copying the shared files to $DATA failed." >&2; echo "ack-wrappers: check free space and permissions there." >&2; exit 1; }
  while IFS= read -r rel; do
    chmod 755 "$DATA/${rel#./}"
  done <<EOT
$(cd "$SHARE" && find . -type d)
EOT
  while IFS= read -r rel; do
    f="$DATA/${rel#./}"; first=""
    IFS= read -r first < "$f"
    case "$first" in '#!'*) chmod 755 "$f" ;; *) chmod 644 "$f" ;; esac
  done <<EOT
$(cd "$SHARE" && find . -type f)
EOT
  # ack-doctor compares this with the plugin's share/ to tell that a refresh is due
  rm -f "$DATA/.ack-sum"
  if ack_share_sum "$SHARE"; then printf '%s\n' "$REPLY" > "$DATA/.ack-sum"; fi
  return 0
}

# ------------------------------------------------------------ subcommands

cmd_list() {
  local n file st
  ALLOWED="--dir"; _parse "$@"
  for n in $(ack_provider_names "$SHARE") danger; do
    DESC="(definition error)"
    if [ "$n" = danger ]; then OPT_PERM=""; _select danger
    else ack_provider_load "$n" "$SHARE" >/dev/null 2>&1 && DESC="$ACK_C_DESCRIPTION"; fi
    _find_wrapper_dir "$n"; file="$TARGET/claude_with_$n"
    _state "$file"; st="$STATE"
    printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$st" "$STATE_PERM" "$file" "$DESC"
  done
}

cmd_install() {
  local p src name dir file cmdf bashw="" rc=0 st kind
  ALLOWED="--permissions --dir --replace"; _parse "$@"
  _need_names 1; name="${ARGS[0]}"; _valid_name "$name"
  _select "$name"
  _target_dir; dir="$TARGET"; file="$dir/claude_with_$name"; cmdf="$file.cmd"
  _data_abs; _check_data
  if _is_windows; then
    _bash_windows || { echo "ack-wrappers: cannot determine the path of this bash (cygpath failed)." >&2; echo "ack-wrappers: run it from Git Bash." >&2; exit 1; }
    bashw="$REPLY"
  fi
  TMP="$(mktemp -d)"
  _wrapper_text "$name" "$PERM" > "$TMP/new"
  _cmd_text "$name" "$PERM" "$bashw" > "$TMP/new.cmd"
  if [ "$OPT_REPLACE" = 0 ]; then
    _state "$file"; [ "$STATE" = foreign ] && { _show_foreign "$file"; rc=3; }
    if _is_windows; then
      _state "$cmdf"; [ "$STATE" = foreign ] && { _show_foreign "$cmdf"; rc=3; }
    fi
    if [ "$rc" = 3 ]; then
      echo "ack-wrappers: re-run with --replace to keep a .bak-YYYY-MM-DD copy and install over it, or pick another --dir." >&2
      exit 3
    fi
  fi
  mkdir -p "$dir" || { echo "ack-wrappers: cannot create $dir." >&2; echo "ack-wrappers: pass --dir with a writable directory." >&2; exit 1; }
  _absdir "$dir"; dir="$REPLY"; file="$dir/claude_with_$name"; cmdf="$file.cmd"
  [ -w "$dir" ] || { echo "ack-wrappers: $dir is not writable." >&2; echo "ack-wrappers: pass --dir with a folder you can write to." >&2; exit 1; }
  _sync_share
  for kind in wrapper cmd; do
    if [ "$kind" = wrapper ]; then p="$file"; src="$TMP/new"
    else _is_windows || continue; p="$cmdf"; src="$TMP/new.cmd"; fi
    _state "$p"; st="installed"
    case "$STATE" in
      foreign) if [ "$OPT_REPLACE" = 1 ]; then _backup "$p" || exit 1; else exit 3; fi ;;
      installed) st="updated" ;;
    esac
    cat "$src" > "$p" || { echo "ack-wrappers: cannot write $p." >&2; echo "ack-wrappers: check the permissions of $dir." >&2; exit 1; }
    [ "$kind" = wrapper ] && chmod 755 "$p"
    printf '%s\t%s\t%s\t%s\n' "$kind" "$st" "$name" "$p"
  done
  if ! _dir_on_path "$dir"; then
    if _path_pending "$dir"; then printf 'path\tpending\t%s\n' "$dir"
    else printf 'path\tmissing\t%s\n' "$dir"; fi
  fi
  return 0
}

cmd_uninstall() {
  local name file cmdf rc=0 p kind bad="" files
  ALLOWED="--dir"; _parse "$@"
  _need_names 1; name="${ARGS[0]}"; _valid_name "$name"
  _find_wrapper_dir "$name"; file="$TARGET/claude_with_$name"; cmdf="$file.cmd"
  files=("$file"); _is_windows && files+=("$cmdf")
  for p in "${files[@]}"; do
    _state "$p"
    [ "$STATE" = foreign ] && { printf 'foreign%s%s\n' "$TAB" "$p"; rc=3; bad="${bad:+$bad and }$p"; }
  done
  if [ "$rc" = 3 ]; then
    _foreign_msg "$bad" "If your wrapper lives elsewhere, pass its folder with --dir; otherwise remove the file by hand."
    exit 3
  fi
  for p in "${files[@]}"; do
    kind=wrapper; [ "$p" = "$cmdf" ] && kind=cmd
    _state "$p"
    case "$STATE" in
      installed) rm -f "$p" && printf '%s\t%s\t%s\t%s\n' "$kind" removed "$name" "$p" ;;
      absent) [ "$kind" = wrapper ] && printf '%s\t%s\t%s\t%s\n' wrapper absent "$name" "$p" ;;
    esac
  done
  return 0
}

cmd_dir() {
  ALLOWED="--dir"; _parse "$@"
  [ "${#ARGS[@]}" = 0 ] || usage_err "dir takes no argument."
  _target_dir
  if _dir_on_path "$TARGET"; then printf 'dir\tok\t%s\n' "$TARGET"
  else printf 'dir\tmissing\t%s\n' "$TARGET"; fi
}
# _path_profile DIR -> PROFILE_FILES (newline separated) and PROFILE_LINE: the
# shell profiles path-fix writes to and the marked line it puts there for DIR.
_path_profile() {
  local dir="$1"
  case "${SHELL##*/}" in zsh) PROFILE_FILES="$HOME/.zshrc" ;; *) PROFILE_FILES="$HOME/.bashrc" ;; esac
  case "$OSTYPE" in darwin*) [ -f "$HOME/.bash_profile" ] && PROFILE_FILES="$PROFILE_FILES"$'\n'"$HOME/.bash_profile" ;; esac
  case "$dir" in "${HOME%/}"/*) _dq "${dir#"${HOME%/}"/}"; PROFILE_LINE="export PATH=\"\$HOME/$REPLY:\$PATH\" # agent-construction-kit" ;;
    *) _dq "$dir"; PROFILE_LINE="export PATH=\"$REPLY:\$PATH\" # agent-construction-kit" ;; esac
}
# _path_pending DIR: 0 when a profile already carries the marked line for DIR
# (path-fix ran; new terminals have the directory on PATH). Never on Windows.
_path_pending() {
  local f
  _is_windows && return 1
  case "$HOME" in /*) ;; *) return 1 ;; esac
  _path_profile "$1"
  while IFS= read -r f; do
    [ -f "$f" ] && grep -Fxq -- "$PROFILE_LINE" "$f" && return 0
  done <<EOT
$PROFILE_FILES
EOT
  return 1
}
cmd_path_fix() {
  local dir files f line shown have
  ALLOWED="--dir"; _parse "$@"
  _target_dir; dir="$TARGET"
  if _dir_on_path "$dir"; then printf 'path\tok\t%s\n' "$dir"; return 0; fi
  if _is_windows; then
    shown="$(cygpath -w "$dir")"
    printf 'path\tmanual\t%s\n' "$shown"
    echo "ack-wrappers: Windows keeps PATH in the user environment, which this script does not change."
    echo "ack-wrappers: in PowerShell run: [Environment]::SetEnvironmentVariable('Path', [Environment]::GetEnvironmentVariable('Path','User') + ';$shown', 'User') -- then open a new terminal."
    return 0
  fi
  case "$HOME" in /*) ;; *) usage_err "HOME is not set to an absolute path." ;; esac
  _path_profile "$dir"; files="$PROFILE_FILES"; line="$PROFILE_LINE"
  while IFS= read -r f; do
    if [ -f "$f" ] && have="$(grep -F -- '# agent-construction-kit' "$f")" && [ -n "$have" ]; then
      have="${have%%$'\n'*}"
      if [ "$have" = "$line" ]; then printf 'path\tunchanged\t%s\n' "$f"
      else printf 'path\texists\t%s\t%s\n' "$f" "$have"; fi
      continue
    fi
    if [ -f "$f" ] && [ -n "$(tail -c1 "$f")" ]; then printf '\n' >> "$f"; fi
    printf '%s\n' "$line" >> "$f" || { echo "ack-wrappers: cannot write $f." >&2; echo "ack-wrappers: add the line yourself: $line" >&2; exit 1; }
    printf 'path\tfixed\t%s\n' "$f"
  done <<EOT
$files
EOT
  return 0
}

# _key_template NAME -> KEYFILE (creates the file with mode 600 if missing)
_key_template() {
  local var f kd
  _valid_name "$1"
  ack_provider_load "$1" "$SHARE" || exit 2
  var="$ACK_C_KEY_FILE_VAR"; f="$ACK_C_KEY_FILE"
  if [ "$ACK_C_KEY_REQUIRED" = 0 ] || [ -z "$var" ]; then
    echo "ack-wrappers: provider '$1' needs no key file." >&2
    echo "ack-wrappers: run 'ack-wrappers test $1' to check that it works." >&2
    exit 2
  fi
  if [ -L "$f" ] && [ ! -e "$f" ]; then
    echo "ack-wrappers: $f is a symlink to nothing." >&2
    echo "ack-wrappers: remove the link or create what it points to." >&2
    exit 2
  fi
  if [ ! -e "$f" ]; then
    case "$f" in */*) kd="${f%/*}" ;; *) kd=. ;; esac
    mkdir -p "$kd" || { echo "ack-wrappers: cannot create the folder of $f." >&2; echo "ack-wrappers: check its permissions." >&2; exit 1; }
    ( umask 077; printf '%s=\n' "$var" > "$f" ) || { echo "ack-wrappers: cannot write $f." >&2; echo "ack-wrappers: check its permissions." >&2; exit 1; }
    chmod 600 "$f" 2>/dev/null
  fi
  KEYFILE="$f"
}
cmd_key_template() {
  ALLOWED=""; _parse "$@"; _need_names 1
  _key_template "${ARGS[0]}"; printf '%s\n' "$KEYFILE"
}
_open_editor() { # FILE -> 0 when an editor ran
  local f="$1"
  # a terminal editor needs the real terminal
  if [ -n "${EDITOR:-}" ] && [ -t 0 ]; then
    ( set -f; set -- $EDITOR; type -P "$1" >/dev/null 2>&1 && "$@" "$f" ) && return 0
  fi
  if _is_windows; then
    type -P notepad >/dev/null 2>&1 && notepad "$(cygpath -w "$f")" >/dev/null 2>&1 </dev/null
    return
  fi
  case "$OSTYPE" in
    darwin*) type -P open >/dev/null 2>&1 && open -t "$f" >/dev/null 2>&1 </dev/null; return ;;
  esac
  type -P xdg-open >/dev/null 2>&1 && xdg-open "$f" >/dev/null 2>&1 </dev/null
}
cmd_key_edit() {
  ALLOWED=""; _parse "$@"; _need_names 1
  _key_template "${ARGS[0]}"; printf '%s\n' "$KEYFILE"
  _open_editor "$KEYFILE" || {
    echo "ack-wrappers: no editor could be started." >&2
    echo "ack-wrappers: open $KEYFILE yourself and put the key after the '='." >&2; }
  return 0
}

# _conf_put FILE KEY VALUE: replace the key in place (drop repeats) or append it
_conf_put() {
  local f="$1" k="$2" v="$3" tmp="$1.tmp.$$" line t key done=0
  : > "$tmp" || { rm -f "$tmp"; return 1; }
  if [ -f "$f" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      _ack_trim "$line"; t="$REPLY"; key=""
      case "$t" in *=*) case "$t" in '#'*) ;; *) _ack_trim "${t%%=*}"; key="$REPLY" ;; esac ;; esac
      if [ "$key" = "$k" ]; then
        [ "$done" = 0 ] && printf '%s=%s\n' "$k" "$v" >> "$tmp"
        done=1
      else printf '%s\n' "$line" >> "$tmp"; fi
    done < "$f"
  fi
  [ "$done" = 1 ] || printf '%s=%s\n' "$k" "$v" >> "$tmp"
  mv "$tmp" "$f" || { rm -f "$tmp"; return 1; }
}
# _conf_write SRC DEST: DEST gets SRC's content and SRC goes; a symlinked DEST is
# written through, so the link keeps pointing at the user's file
_conf_write() {
  if [ -L "$2" ]; then cat "$1" > "$2" && rm -f "$1"
  else mv "$1" "$2"; fi
}
cmd_set() {
  local name f prev work kv k v keyvar i ks=() vs=()
  ALLOWED=""; _parse "$@"; _need_names 2; name="${ARGS[0]}"; _valid_name "$name"
  ack_provider_load "$name" "$SHARE" || exit 2
  keyvar="$ACK_C_KEY_VAR"
  for kv in "${ARGS[@]:1}"; do
    case "$kv" in *=*) ;; *) usage_err "'$kv' is not KEY=VALUE." ;; esac
    k="${kv%%=*}"; _ack_trim "${kv#*=}"; v="$REPLY"
    case "$kv" in *$'\n'*|*$'\r'*) usage_err "the value of $k must be a single line." ;; esac
    case "$k" in ''|*[!A-Z_]*) usage_err "'$k' is not a definition key (only A-Z and _)." ;; esac
    case "$k" in
      *API_KEY*|*SECRET*|"$keyvar")
        echo "ack-wrappers: $k looks like an API key, and keys never go into a definition." >&2
        echo "ack-wrappers: run 'ack-wrappers key-edit $name' and put the key into the key file." >&2
        exit 2 ;;
    esac
    if [ "$k" = AUTH_TOKEN ] && [ -n "$v" ] && ! ack_is_word "$v"; then
      echo "ack-wrappers: AUTH_TOKEN takes only a short word such as local or proxy (letters and -, at most 16), and keys never go into a definition." >&2
      echo "ack-wrappers: put a key into the key file with 'ack-wrappers key-edit $name'; for a local model without one, run new-local again with --key-var and --replace." >&2
      exit 2
    fi
    _check_hash "$k" "$v"
    ks+=("$k"); vs+=("$v")
  done
  # the file is the user's own: only they read it, and a symlink keeps pointing where it did
  umask 077
  f="$ACK_CONFIG_DIR/providers/$name.conf"; work="$f.new.$$"; prev="$f.prev.$$"
  if [ -L "$f" ] && [ ! -e "$f" ]; then
    echo "ack-wrappers: $f is a symlink to nothing." >&2
    echo "ack-wrappers: remove the link or create what it points to." >&2
    exit 2
  fi
  mkdir -p "${f%/*}" || { echo "ack-wrappers: cannot create ${f%/*}." >&2; echo "ack-wrappers: check its permissions." >&2; exit 1; }
  if [ -f "$f" ]; then cp "$f" "$work" && cp "$f" "$prev" || { rm -f "$work" "$prev"; exit 1; }; else prev=""; fi
  i=0
  while [ "$i" -lt "${#ks[@]}" ]; do
    _conf_put "$work" "${ks[$i]}" "${vs[$i]}" || {
      rm -f "$work" "$prev"
      echo "ack-wrappers: cannot write $f." >&2; echo "ack-wrappers: check its permissions." >&2; exit 1; }
    i=$((i + 1))
  done
  _conf_write "$work" "$f" || { rm -f "$work" "$prev"; echo "ack-wrappers: cannot write $f." >&2; echo "ack-wrappers: check its permissions." >&2; exit 1; }
  chmod 600 "$f" 2>/dev/null
  if ! ack_provider_load "$name" "$SHARE"; then
    if [ -n "$prev" ]; then _conf_write "$prev" "$f"; else rm -f "$f"; fi
    echo "ack-wrappers: those values break the definition of '$name', so nothing was changed." >&2
    echo "ack-wrappers: check the \${KEY} references in the values." >&2
    exit 2
  fi
  i=0
  while [ "$i" -lt "${#ks[@]}" ]; do
    v="${vs[$i]}"
    [ "${ks[$i]}" = BASE_URL ] && { ack_strip_url "$v"; v="$REPLY"; }
    printf 'set%s%s%s%s\n' "$TAB" "${ks[$i]}" "$TAB" "$v"
    i=$((i + 1))
  done
  [ -n "$prev" ] && rm -f "$prev"
  return 0
}

# _host_of -> REPLY: host[:port] of the loaded provider's BASE_URL
_host_of() {
  local u="$ACK_C_BASE_URL"
  u="${u#*://}"; u="${u%%/*}"; u="${u##*@}"
  REPLY="${u:-the provider}"
}
# _mask_key LINE KEY -> REPLY: LINE with every run of 8 or more consecutive characters
# of KEY (the whole key too, also a shorter one) replaced by ***
_mask_key() {
  local key="$2" n i l sub
  REPLY="$1"; n=${#key}
  [ -n "$key" ] || return 0
  REPLY="${REPLY//"$key"/***}"
  i=0
  while [ $((i + 8)) -le "$n" ]; do
    sub="${key:$i:8}"
    case "$REPLY" in
      *"$sub"*)
        # the longest piece from here on that the line holds
        l=$((n - i))
        while [ "$l" -gt 8 ]; do
          case "$REPLY" in *"${key:$i:$l}"*) break ;; esac
          l=$((l - 1))
        done
        sub="${key:$i:$l}"; REPLY="${REPLY//"$sub"/***}"
        i=$((i + l)) ;;
      *) i=$((i + 1)) ;;
    esac
  done
}
cmd_test() {
  local wst name file out rc=0 t=0 limit pid line s kv reason="" ans kit l
  ALLOWED="--dir"; _parse "$@"
  _need_names 1; name="${ARGS[0]}"; _valid_name "$name"
  case "${ACK_TEST_TIMEOUT:-120}" in ''|0*|*[!0-9]*) usage_err "ACK_TEST_TIMEOUT must be a positive whole number of seconds." ;; esac
  OPT_PERM=""; _select "$name"
  _find_wrapper_dir "$name"; file="$TARGET/claude_with_$name"
  _state "$file"
  if [ "$STATE" != installed ]; then
    printf 'test%smissing%sno wrapper installed at %s — run: ack-wrappers install %s\n' "$TAB" "$TAB" "$file" "$name"
    exit 1
  fi
  TMP="$(mktemp -d)"; out="$TMP/out"
  limit=$(( ${ACK_TEST_TIMEOUT:-120} * 5 ))
  "$BASH" "$file" -p "$PROMPT" > "$out" 2>&1 < /dev/null &
  pid=$!; CHILD="$pid"
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$t" -ge "$limit" ]; then kill "$pid" 2>/dev/null; rc=124; break; fi
    sleep 0.2; t=$((t + 1))
  done
  wait "$pid" 2>/dev/null; wst=$?; CHILD=""
  [ "$rc" = 124 ] || rc=$wst
  _host_of; ans="$REPLY"
  line=""
  while IFS= read -r l || [ -n "$l" ]; do
    _ack_trim "$l"; [ -n "$REPLY" ] && { line="$REPLY"; break; }
  done < "$out"
  # A successful run shows the answer, not a notice Claude Code printed before it.
  if [ "$rc" = 0 ]; then
    while IFS= read -r l || [ -n "$l" ]; do
      case "$l" in *[Oo][Kk]*) ;; *) continue ;; esac
      if printf '%s\n' "$l" | grep -Eiq '(^|[^A-Za-z])ok([^A-Za-z]|$)'; then
        _ack_trim "$l"; line="$REPLY"; break
      fi
    done < "$out"
  fi
  # never echo a key, even if a server error quotes one back, whole or in part
  if [ "$name" != danger ]; then
    kv="$ACK_C_KEY_VAR"; s=""
    case "$kv" in ''|[0-9]*|*[!A-Za-z0-9_]*) ;; *) s="${!kv}" ;; esac
    _mask_key "$line" "$s"; line="$REPLY"
    s="$(ack_key_read "$ACK_C_KEY_FILE" "$ACK_C_KEY_FILE_VAR" 2>/dev/null)"
    _mask_key "$line" "$s"; line="$REPLY"
    s="$ACK_C_AUTH_TOKEN"
    ack_is_word "$s" || { _mask_key "$line" "$s"; line="$REPLY"; }
    # credentials in BASE_URL (scheme://user:password@host)
    s="${ACK_C_BASE_URL#*://}"; s="${s%%/*}"
    case "$s" in *@*) s="${s%@*}"; line="${line//"$s"/***}" ;; esac
  fi
  line="${line//$TAB/ }"
  [ "${#line}" -gt 80 ] && line="${line:0:77}..."
  # 3, 4 and 5 are the launcher's own codes only when it said so; a claude or model
  # server may exit with them too
  kit=0
  grep -Eq '^(claude-with|ack):' "$out" && kit=1
  case "$rc:$kit" in
    124:*) reason="could not reach $ans (no answer after ${ACK_TEST_TIMEOUT:-120}s)" ;;
    3:1) reason="no key yet — add it to $ACK_C_KEY_FILE" ;;
    4:1) reason="claude is not installed — install Claude Code, or set ACK_CLAUDE_BIN" ;;
    5:1) if grep -Eiq 'claude-code-proxy is not installed' "$out"; then reason="claude-code-proxy is not installed"
       elif grep -Eiq 'sign(ed)? ?in|log(ged)? ?in' "$out"; then reason="the proxy is not signed in"
       else reason="the proxy did not start"; fi ;;
    *) if [ "$rc" != 0 ] || grep -q 'API Error' "$out"; then
         if grep -Eiq '(^|[^0-9])40[13]([^0-9]|$)|invalid.*(api.?key|x-api-key)|authentication|unauthori' "$out"; then
           reason="the provider rejected the key"
         elif grep -Eiq 'ECONNREFUSED|ENOTFOUND|ETIMEDOUT|connect|resolve|time.?out|network' "$out"; then
           reason="could not reach $ans"
         else reason="${line:-claude exited with status $rc and no output}"; fi
       fi ;;
  esac
  # the answer is a line that is just OK; one that only mentions it (an echoed
  # prompt, "Not OK") is not
  if [ -z "$reason" ]; then
    s=1
    while IFS= read -r l || [ -n "$l" ]; do
      l="${l//[[:space:][:punct:]]/}"
      case "$l" in [Oo][Kk]) s=0; break ;; esac
    done < "$out"
    [ "$s" = 0 ] || reason="unexpected answer: ${line:-(empty)}"
  fi
  if [ -n "$reason" ]; then printf 'test%smissing%s%s\n' "$TAB" "$TAB" "$reason"; exit 1; fi
  printf 'test%sok%s%s\n' "$TAB" "$TAB" "$line"
}

# ----------------------------------------------------------- local models

# _prefix_of NAME -> REPLY: PREFIX of the definition NAME (shipped, then user layer)
_prefix_of() {
  REPLY="$(
    ACK_KEYS="" ACK_R_PREFIX=""
    [ -f "$SHARE/providers/$1.conf" ] && _ack_read_def "$SHARE/providers/$1.conf" >/dev/null 2>&1
    [ -f "$ACK_CONFIG_DIR/providers/$1.conf" ] && _ack_read_def "$ACK_CONFIG_DIR/providers/$1.conf" >/dev/null 2>&1
    printf '%s' "$ACK_R_PREFIX"
  )"
}

# _model_ids BODY -> REPLY: the model ids of a /v1/models reply, one per line; 1 when the
# body is not a model list. Only ids that open an object count (a "permission" array or
# an error object carries ids of its own); without any such id all remaining ids do.
_model_ids() {
  local flat
  flat="$(printf '%s' "$1" | tr '\n\r\t' '   ')"
  printf '%s' "$flat" | grep -q '"data" *: *\[' || return 1
  printf '%s' "$flat" | grep -q '"error" *:' && return 1
  flat="$(printf '%s' "$flat" | sed -e 's/"permission" *: *\[[^]]*\]//g')"
  REPLY="$(printf '%s' "$flat" | grep -o '{ *"id" *: *"[^"]*"' | sed -e 's/^{ *"id" *: *"//' -e 's/"$//')"
  if [ -z "$REPLY" ]; then
    REPLY="$(printf '%s' "$flat" | grep -o '"id" *: *"[^"]*"' | sed -e 's/^"id" *: *"//' -e 's/"$//')"
  fi
  [ -n "$REPLY" ]
}

cmd_probe_local() {
  local port url body id seen ids
  ALLOWED=""; _parse "$@"
  [ "${#ARGS[@]}" = 0 ] || usage_err "probe-local takes no arguments."
  if [ -z "$(type -P curl 2>/dev/null)" ]; then
    echo "ack-wrappers: curl is not installed, so local servers cannot be probed; install curl and try again." >&2
    return 0
  fi
  for port in 11434 1234 8000 8080; do
    url="http://127.0.0.1:$port"
    body="$(curl -s --noproxy '*' --max-time 2 "$url/v1/models" 2>/dev/null)" || continue
    _model_ids "$body" || continue
    ids="$REPLY"
    seen=$'\n'
    while IFS= read -r id || [ -n "$id" ]; do
      case "$id" in ''|*\\*) continue ;; esac
      case "$seen" in *$'\n'"$id"$'\n'*) continue ;; esac
      seen="$seen$id"$'\n'
      printf 'local%s%s%s%s\n' "$TAB" "$url" "$TAB" "$id"
    done <<EOT
$ids
EOT
  done
  return 0
}

cmd_new_local() {
  local name pfx f n other bak shown
  ALLOWED="--url --model --context --thinking --key-var --replace"; _parse "$@"
  _need_names 1; name="${ARGS[0]}"
  [ "${#ARGS[@]}" = 1 ] || usage_err "new-local takes exactly one name."
  case "$name" in
    [a-z]*) case "$name" in *[!a-z0-9_-]*) name="" ;; esac ;;
    *) name="" ;;
  esac
  [ -n "$name" ] || usage_err "'${ARGS[0]}' is not a valid provider name (start with a-z, then a-z, 0-9, - and _)."
  [ "$name" != danger ] || usage_err "'danger' is a reserved name; pick another."
  [ -n "$OPT_URL" ] || usage_err "new-local needs --url (try 'ack-wrappers probe-local' to find one)."
  [ -n "$OPT_MODEL" ] || usage_err "new-local needs --model (try 'ack-wrappers probe-local' to find one)."
  case "$OPT_URL" in http://*|https://*) ;; *) usage_err "--url must start with http:// or https://." ;; esac
  case "$OPT_URL" in *[[:space:]]*) usage_err "--url must not contain whitespace." ;; esac
  case "$OPT_MODEL" in *$'\n'*|*$'\r'*) usage_err "--model must be a single line." ;; esac
  _ack_trim "$OPT_MODEL"; OPT_MODEL="$REPLY"
  [ -n "$OPT_MODEL" ] || usage_err "--model must not be empty."
  _check_hash --model "$OPT_MODEL"
  _check_hash DESCRIPTION "Local model $OPT_MODEL at $OPT_URL"
  case "$OPT_MODEL" in '#'*) usage_err "--model must not start with '#', where the loader cuts the line." ;; esac
  case "$OPT_URL$OPT_MODEL" in *'${'*) usage_err "--url and --model must not contain a \${...} reference." ;; esac
  for n in context thinking; do
    case "$n" in context) other="$OPT_CONTEXT" ;; *) other="$OPT_THINKING" ;; esac
    case "$other" in
      '') ;;
      0) ;;
      0*|*[!0-9]*) usage_err "--$n must be a whole number without a leading zero." ;;
    esac
  done
  if [ -n "$OPT_KEYVAR" ]; then
    case "$OPT_KEYVAR" in
      PATH|HOME|SHELL|USER|ANTHROPIC_*|CLAUDE_*|ACK_*)
        usage_err "--key-var $OPT_KEYVAR is a variable the system or the kit uses; pick another name." ;;
    esac
    case "$OPT_KEYVAR" in
      [A-Z]*) case "$OPT_KEYVAR" in *[!A-Z0-9_]*) usage_err "--key-var must be upper case letters, digits and _, starting with a letter." ;; esac ;;
      *) usage_err "--key-var must be upper case letters, digits and _, starting with a letter." ;;
    esac
  fi
  if [ -e "$SHARE/providers/$name.conf" ]; then
    echo "ack-wrappers: '$name' is the name of a shipped provider and would hide it." >&2
    echo "ack-wrappers: pick another name; 'ack-wrappers set $name KEY=VALUE' changes the shipped one." >&2
    exit 2
  fi
  pfx="$(printf '%s' "$name" | tr 'a-z-' 'A-Z_')"
  for other in $(ack_provider_names "$SHARE"); do
    [ "$other" = "$name" ] && continue
    _prefix_of "$other"
    if [ "$REPLY" = "$pfx" ]; then
      echo "ack-wrappers: '$name' would get the PREFIX $pfx, which provider '$other' already uses." >&2
      echo "ack-wrappers: pick a name that differs in more than - and _." >&2
      exit 2
    fi
  done
  case "$pfx" in
    ANTHROPIC|CLAUDE|ACK|ANTHROPIC_*|CLAUDE_*|ACK_*)
      echo "ack-wrappers: '$name' would get the PREFIX $pfx, and an outer $pfx variable would override the definition." >&2
      echo "ack-wrappers: pick another name that does not start with anthropic, claude or ack." >&2
      exit 2 ;;
  esac
  f="$ACK_CONFIG_DIR/providers/$name.conf"
  if [ -e "$f" ] || [ -L "$f" ]; then
    if [ "$OPT_REPLACE" = 0 ]; then
      printf 'foreign%s%s\n' "$TAB" "$f"
      if grep -Fq -- '# Written by "ack-wrappers new-local"' "$f" 2>/dev/null; then
        echo "ack-wrappers: a definition named $name exists already; pass --replace to overwrite it" >&2
        exit 3
      fi
      _foreign_msg "$f" "Re-run with --replace to keep a .bak copy and write the new definition, or pick another name."
      exit 3
    fi
  fi
  umask 077
  mkdir -p "${f%/*}" || { echo "ack-wrappers: cannot create ${f%/*}." >&2; echo "ack-wrappers: check its permissions." >&2; exit 1; }
  TMP="$(mktemp -d)"
  ack_strip_url "$OPT_URL"; shown="$REPLY"   # list prints DESCRIPTION: no credentials there
  {
    printf '# Local model served at %s.\n' "$shown"
    printf '# Written by "ack-wrappers new-local"; edit freely, or change single values with "ack-wrappers set %s KEY=VALUE".\n' "$name"
    printf 'DESCRIPTION=Local model %s at %s\n' "$OPT_MODEL" "$shown"
    printf 'PREFIX=%s\n' "$pfx"
    printf 'BASE_URL=%s\n' "$OPT_URL"
    printf 'MODEL=%s\n' "$OPT_MODEL"
    for n in OPUS SONNET HAIKU SMALL; do printf '%s_MODEL=${MODEL}\n' "$n"; done
    printf 'CO_AUTHORED_BY=${MODEL}\n'
    printf 'UNKNOWN_MODEL_WINDOW=1\nDISABLE_NONESSENTIAL_TRAFFIC=1\nDISABLE_EXPERIMENTAL_BETAS=1\nTOOL_SEARCH=false\n'
    # 0 matters: without it claude expects a thinking block in every answer
    printf 'MAX_THINKING_TOKENS=%s\n' "${OPT_THINKING:-0}"
    if [ -n "$OPT_CONTEXT" ]; then
      printf 'CONTEXT_WINDOW=%s\nMAX_CONTEXT_TOKENS=%s\nAUTOCOMPACT_PCT=70\n' "$OPT_CONTEXT" "$OPT_CONTEXT"
    fi
    if [ -n "$OPT_KEYVAR" ]; then printf 'KEY_VAR=%s\n' "$OPT_KEYVAR"
    else printf 'KEY_REQUIRED=0\nAUTH_TOKEN=local\n'; fi
  } > "$TMP/new"
  bak=""
  if [ -e "$f" ] || [ -L "$f" ]; then
    bak="$(_backup "$f")" || exit 1
    printf '%s\n' "$bak"; bak="${bak##*"$TAB"}"
  fi
  cat "$TMP/new" > "$f" || { rm -f "$f"; [ -n "$bak" ] && mv "$bak" "$f"; echo "ack-wrappers: cannot write $f." >&2; echo "ack-wrappers: check the permissions of ${f%/*}." >&2; exit 1; }
  printf 'conf%screated%s%s%s%s\n' "$TAB" "$TAB" "$name" "$TAB" "$f"
  return 0
}

main() {
  [ $# -gt 0 ] || usage_err "missing subcommand."
  local sub="$1"
  shift
  case "$sub" in
    list) cmd_list "$@" ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    path-fix) cmd_path_fix "$@" ;;
    dir) cmd_dir "$@" ;;
    key-template) cmd_key_template "$@" ;;
    key-edit) cmd_key_edit "$@" ;;
    set) cmd_set "$@" ;;
    test) cmd_test "$@" ;;
    probe-local) cmd_probe_local "$@" ;;
    new-local) cmd_new_local "$@" ;;
    -h|--help|help) _help; exit 0 ;;
    *) usage_err "unknown subcommand '$sub'." ;;
  esac
}
main "$@"
