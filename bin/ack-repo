#!/usr/bin/env bash
# ack-repo: read a directory's git state, create a repository, create a disk remote.
#   ack-repo inspect [DIR]
#   ack-repo init [--own] [DIR]
#   ack-repo disk-remote <TARGET-DIR> [--name NAME] [--dir DIR]
# DIR defaults to the current directory (one that starts with - only when it exists, else
# it is an unknown option). Output is tab separated, one fact per line:
#   git<TAB>ok|missing<TAB>TOPLEVEL-or-DIR       missing = not a repository
#   git<TAB>inside|home<TAB>TOPLEVEL             DIR lies below the top folder of a repository,
#                                                or that top folder is the home folder; then
#                                                no commits/branch/dirty/remote lines, and
#                                                the rest is read from DIR itself
#   git<TAB>refused<TAB>FOLDER<TAB>REASON        FOLDER holds a .git git refuses to read;
#                                                REASON is git's (dubious ownership, ...)
#   commits<TAB>N   branch<TAB>NAME   dirty<TAB>N      (only for a repository; NAME is
#                                                "detached" on a detached HEAD; dirty counts
#                                                changed and untracked files, each one)
#   remote<TAB>NAME<TAB>KIND<TAB>URL             one per remote, URL without credentials;
#                                                KIND = github|codeberg|gitlab|forge|disk|other
#   signal<TAB>KIND<TAB>FILE                     KIND = perl|node|python|go|rust|make|ci
#   tests<TAB>DIR<TAB>N<TAB>nested|flat          N files; nested = tests in subdirectories;
#                                                caches and helper folders (fake, fakes,
#                                                fixture, fixtures, testdata, data,
#                                                __snapshots__, __mocks__) do not count
#   team<TAB>agents|rules|skills<TAB>N   team<TAB>skilletor<TAB>yes|no
#   team<TAB>board<TAB>karr|file|none            karr = refs/karr/* exist, file = BOARD.md at the top
#   account<TAB>SERVICE<TAB>SOURCE<TAB>NAME      per hosting service found on this machine (not per
#                                                repo); SERVICE = github|gitlab|codeberg;
#                                                SOURCE = gh|glab (tool on PATH with a login, NAME is
#                                                the user), else ssh (host in ~/.ssh/config or
#                                                known_hosts), else gitconfig (global url.*/credential.*
#                                                names the host); NAME is empty for ssh and gitconfig.
#                                                Read only, offline, never a token or key.
#   sibling<TAB>DIR                              a neighbour with git and the same name prefix
#   prefix<TAB>NAME                              the name in kebab-case, without p5-/node-/py-
# A bare repository has no work tree, so inspect reports it as "git<TAB>missing".
# inspect only reads. init runs "git init" on branch main and writes a .gitignore when
# there is none; it prints "git<TAB>created<TAB>DIR", or "git<TAB>ok<TAB>DIR" when DIR is
# already the top folder of a repository, a bare repository or a .git directory, or
# "git<TAB>inside|home<TAB>TOPLEVEL" (as inspect) when DIR lies in another repository;
# then nothing changes, no commit either. With --own, init creates DIR's own repository
# inside that other one (which then sees DIR as an untracked folder), unless that one
# tracks files in DIR. init refuses the home folder and a .git git refuses to read.
# disk-remote creates TARGET-DIR/<repo>.git as a bare repository, adds it as remote NAME
# (default origin; backup when origin is taken) and pushes all branches. It prints
# "remote<TAB>created<TAB>NAME<TAB>PATH" and "push<TAB>ok|skipped<TAB>REASON" (skipped
# while there is no commit). --dir DIR selects the repository (default: current directory).
# Exit codes: 0 ok, 1 the push failed, 2 usage error or unusable target (missing, not
# writable, inside the repository, DIR is no repository, init on the home folder), 3
# something is in the way: that name already exists, git refuses the .git there, or the
# other repository tracks files in DIR (nothing changed).
# Errors are two lines on stderr: "ack-repo: <what>" and "ack-repo: <what to do>".

_help() {
  local n=0 line
  while IFS= read -r line; do
    n=$((n + 1))
    [ "$n" -ge 2 ] || continue
    case "$line" in '#'*) line="${line#\#}"; printf '%s\n' "${line# }" ;; *) break ;; esac
  done < "$_self"
}

# Git for Windows may hand over a backslash path (bash 'D:\x\ack-repo').
_slashes() { case "$OSTYPE" in msys*|cygwin*) REPLY="${1//\\//}" ;; *) REPLY="$1" ;; esac; }
_slashes "${BASH_SOURCE[0]}"; _self="$REPLY"
_src="$_self"
while [ -L "$_src" ]; do
  _slashes "$(readlink "$_src")"; _t="$REPLY"
  case "$_t" in
    /*) _src="$_t" ;;
    *) case "$_src" in */*) _src="${_src%/*}/$_t" ;; *) _src="./$_t" ;; esac ;;
  esac
done
case "$_src" in */*) _dir="${_src%/*}" ;; *) _dir="." ;; esac
if ! SHARE="$(cd "$_dir/../share" 2>/dev/null && pwd)"; then
  echo "ack-repo: cannot find the share directory next to bin/." >&2
  echo "ack-repo: reinstall agent-construction-kit." >&2
  exit 2
fi
# shellcheck source=../share/lib.sh
. "$SHARE/lib.sh" || exit 2

TAB=$'\t'

# fail CODE WHAT TODO
fail() {
  echo "ack-repo: $2" >&2
  echo "ack-repo: $3" >&2
  exit "$1"
}
usage_err() {
  fail 2 "$1" "usage: ack-repo inspect|init|disk-remote (see the header of $0)."
}

command -v git >/dev/null 2>&1 || fail 2 "git is not installed." "install git and run ack-repo again."

# _absdir DIR -> REPLY (logical absolute path), fails when DIR is no directory. CDPATH
# is cleared: cd would take a folder of that name from it and print its path.
_absdir() { REPLY="$(CDPATH= cd -- "$1" 2>/dev/null && pwd)" && [ -n "$REPLY" ]; }
_physdir() { REPLY="$(CDPATH= cd -- "$1" 2>/dev/null && pwd -P)" && [ -n "$REPLY" ]; }

# _toplevel DIR -> REPLY: the repository's top directory; fails outside a repository
_toplevel() {
  REPLY="$(CDPATH= cd -- "$1" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)" && [ -n "$REPLY" ]
}

# _same_dir A B: both name the same directory (physical paths; case-blind on macOS and
# Windows, whose disks usually are)
_same_dir() {
  local a b
  _physdir "$1" && a="$REPLY" || return 1
  _physdir "$2" && b="$REPLY" || return 1
  case "$OSTYPE" in
    darwin*|msys*|cygwin*)
      a="$(printf '%s' "$a" | tr 'A-Z' 'a-z')"; b="$(printf '%s' "$b" | tr 'A-Z' 'a-z')" ;;
  esac
  [ "$a" = "$b" ]
}

# _where DIR -> WHERE and REPLY (the top folder) for a DIR in a work tree: WHERE is ok
# when DIR is the top folder, home when the top folder is the home folder, inside when
# DIR lies below the top folder. Fails outside a work tree.
_where() {
  local top pre
  _toplevel "$1" || return 1
  top="$REPLY" WHERE=ok
  if _same_dir "$top" "$HOME"; then
    WHERE=home
  else
    pre="$(CDPATH= cd -- "$1" 2>/dev/null && git rev-parse --show-prefix 2>/dev/null)"
    [ -z "$pre" ] || WHERE=inside
  fi
  REPLY="$top"
}

# _count N -> REPLY without the padding some wc versions add
_count() { REPLY="${1//[[:space:]]/}"; [ -n "$REPLY" ] || REPLY=0; }

# _kebab NAME -> REPLY: small letters and digits, dashes between, no p5-/node-/py-
_kebab() {
  local n
  n="$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-' | tr -s '-')"
  n="${n#-}"; n="${n%-}"
  case "$n" in
    p5-?*) n="${n#p5-}" ;;
    node-?*) n="${n#node-}" ;;
    py-?*) n="${n#py-}" ;;
  esac
  REPLY="$n"
}

# _host URL -> REPLY: the host part of a remote URL (empty for a local path)
_host() {
  local u="$1"
  case "$u" in
    *://*) u="${u#*://}"; u="${u##*@}"; REPLY="${u%%[/:]*}" ;;
    /*|./*|../*|[A-Za-z]:[\\/]*|'') REPLY="" ;;
    *:*) u="${u%%:*}"; REPLY="${u##*@}" ;;
    *) REPLY="" ;;
  esac
}

# _kind URL -> REPLY (URL already without credentials)
_kind() {
  local u="$1" h
  case "$u" in
    file://*|/*|./*|../*|[A-Za-z]:[\\/]*) REPLY=disk; return ;;
  esac
  _host "$u"; h="$(printf '%s' "$REPLY" | tr 'A-Z' 'a-z')"
  case "$h" in
    '') REPLY=disk ;;
    *github.com*) REPLY=github ;;
    *codeberg.org*) REPLY=codeberg ;;
    *gitlab*) REPLY=gitlab ;;
    *gitea*|*forgejo*|git.*|*.git.*) REPLY=forge ;;
    *) REPLY=other ;;
  esac
}

# ---------------------------------------------------------------- inspect

cmd_inspect() {
  local dir="${1:-.}" top base name f d n f2 rel nested kind url
  [ $# -le 1 ] || usage_err "inspect takes at most one directory."
  case "$dir" in -*) [ -d "$dir" ] || usage_err "unknown option '$dir'." ;; esac
  [ -d "$dir" ] || fail 2 "'$dir' is not a directory." "pass an existing directory."
  _absdir "$dir" || fail 2 "cannot enter '$dir'." "check its permissions."
  base="$REPLY" top=""
  _where "$base" || WHERE=""
  # inside or home: another repository's folder, so the rest comes from DIR itself (and
  # no status runs over a whole home folder)
  if [ "$WHERE" = home ]; then
    printf 'git%shome%s%s\n' "$TAB" "$TAB" "$REPLY"
  elif [ "$WHERE" = inside ]; then
    printf 'git%sinside%s%s\n' "$TAB" "$TAB" "$REPLY"
  elif [ "$WHERE" = ok ]; then
    top="$REPLY"; base="$top"
    printf 'git%sok%s%s\n' "$TAB" "$TAB" "$top"
    if git -C "$top" rev-parse --verify -q HEAD >/dev/null 2>&1; then
      _count "$(git -C "$top" rev-list --count HEAD 2>/dev/null)"
    else
      REPLY=0
    fi
    printf 'commits%s%s\n' "$TAB" "$REPLY"
    n="$(git -C "$top" symbolic-ref --short -q HEAD 2>/dev/null)" || n=""
    printf 'branch%s%s\n' "$TAB" "${n:-detached}"
    _count "$(git -C "$top" status --porcelain -uall 2>/dev/null | wc -l)"
    printf 'dirty%s%s\n' "$TAB" "$REPLY"
    while IFS= read -r name; do
      [ -n "$name" ] || continue
      url="$(git -C "$top" remote get-url "$name" 2>/dev/null)" || url=""
      ack_strip_url "$url"; url="$REPLY"
      _kind "$url"; kind="$REPLY"
      printf 'remote%s%s%s%s%s%s\n' "$TAB" "$name" "$TAB" "$kind" "$TAB" "$url"
    done <<EOT
$(git -C "$top" remote 2>/dev/null)
EOT
  elif ack_git_refused "$base"; then
    printf 'git%srefused%s%s%s%s\n' "$TAB" "$TAB" "$ACK_GIT_AT" "$TAB" "$REPLY"
  else
    printf 'git%smissing%s%s\n' "$TAB" "$TAB" "$base"
  fi

  # build and test signals: top level and .github/workflows only
  for f in Makefile.PL Build.PL dist.ini cpanfile; do
    [ -e "$base/$f" ] && printf 'signal%sperl%s%s\n' "$TAB" "$TAB" "$f"
  done
  [ -e "$base/package.json" ] && printf 'signal%snode%spackage.json\n' "$TAB" "$TAB"
  for f in pyproject.toml setup.py setup.cfg requirements.txt; do
    [ -e "$base/$f" ] && printf 'signal%spython%s%s\n' "$TAB" "$TAB" "$f"
  done
  [ -e "$base/go.mod" ] && printf 'signal%sgo%sgo.mod\n' "$TAB" "$TAB"
  [ -e "$base/Cargo.toml" ] && printf 'signal%srust%sCargo.toml\n' "$TAB" "$TAB"
  # one line only: on a case-insensitive disk (macOS, Windows) Makefile also answers to makefile
  for f in Makefile GNUmakefile; do
    [ -e "$base/$f" ] && { printf 'signal%smake%s%s\n' "$TAB" "$TAB" "$f"; break; }
  done
  for f in .gitlab-ci.yml .woodpecker.yml; do
    [ -e "$base/$f" ] && printf 'signal%sci%s%s\n' "$TAB" "$TAB" "$f"
  done
  for f in "$base"/.github/workflows/*.yml "$base"/.github/workflows/*.yaml; do
    [ -f "$f" ] && printf 'signal%sci%s.github/workflows/%s\n' "$TAB" "$TAB" "${f##*/}"
  done

  # tests
  for d in t tests test spec __tests__; do
    [ -d "$base/$d" ] || continue
    # cache and build files and the folders of test helpers are no tests; one find, one
    # awk: file count and "any file below a subdirectory"
    out="$(find "$base/$d" \( -name __pycache__ -o -name node_modules -o -name .git \) -prune -o \
      -type d \( -name fake -o -name fakes -o -name fixture -o -name fixtures -o -name testdata \
      -o -name data -o -name __snapshots__ -o -name __mocks__ \) -prune -o \
      -type f ! -name '*.pyc' -print 2>/dev/null |
      awk -v p="$base/$d/" '{ n++; if (index(substr($0, length(p) + 1), "/")) f = 1 } END { print n + 0, f + 0 }')"
    n="${out%% *}"; nested=flat
    [ "${out#* }" = 1 ] && nested=nested
    printf 'tests%s%s%s%s%s%s\n' "$TAB" "$d" "$TAB" "$n" "$TAB" "$nested"
  done

  # the team
  for d in agents rules; do
    n=0
    for f in "$base/.claude/$d"/*.md; do [ -f "$f" ] && n=$((n + 1)); done
    printf 'team%s%s%s%s\n' "$TAB" "$d" "$TAB" "$n"
  done
  n=0
  for f in "$base/.claude/skills"/*; do { [ -e "$f" ] || [ -L "$f" ]; } && n=$((n + 1)); done
  printf 'team%sskills%s%s\n' "$TAB" "$TAB" "$n"
  if [ -e "$base/.claude/skilletor.json" ] || [ -e "$base/.claude/skilletor.local.json" ] ||
     [ -e "$base/skilletor.json" ]; then
    printf 'team%sskilletor%syes\n' "$TAB" "$TAB"
  else
    printf 'team%sskilletor%sno\n' "$TAB" "$TAB"
  fi
  if [ -n "$top" ] && [ -n "$(git -C "$top" for-each-ref --count=1 refs/karr 2>/dev/null)" ]; then
    printf 'team%sboard%skarr\n' "$TAB" "$TAB"
  elif [ -f "$base/BOARD.md" ]; then
    printf 'team%sboard%sfile\n' "$TAB" "$TAB"
  else
    printf 'team%sboard%snone\n' "$TAB" "$TAB"
  fi

  # neighbours with git and the same prefix, then the suggested name
  name="${base##*/}"
  _kebab "$name"; n="$REPLY"
  local mine="${n%%-*}" parent="${base%/*}" s sn
  [ -n "$parent" ] || parent="/"
  if [ -n "$mine" ]; then
    # a case-insensitive glob for the prefix, so most neighbours are ruled out without a fork
    local pat="" i c
    for ((i = 0; i < ${#mine}; i++)); do
      c="${mine:i:1}"
      case "$c" in
        [a-z]) pat="$pat[$c$(printf '%s' "$c" | tr 'a-z' 'A-Z')]" ;;
        *) pat="$pat$c" ;;
      esac
    done
    for s in "$parent"/*; do
      [ "$s" != "$base" ] || continue
      sn="${s##*/}"
      case "$sn" in
        $pat*|[Pp]5[-_.]$pat*|[Nn][Oo][Dd][Ee][-_.]$pat*|[Pp][Yy][-_.]$pat*) ;;
        *) continue ;;
      esac
      [ -d "$s" ] && [ -e "$s/.git" ] || continue
      _kebab "$sn"; sn="$REPLY"
      [ "${sn%%-*}" = "$mine" ] && printf 'sibling%s%s\n' "$TAB" "$s"
    done
  fi
  printf 'prefix%s%s\n' "$TAB" "$n"
  _accounts
}

# _yaml_user FILE HOST -> REPLY: the "user:" value at the first indent level below HOST's
# entry in a gh/glab hosts file. Only that one value is ever extracted. Returns 1 when
# there is none; REPLY is empty (return 0) when the value cannot be a user name (a token).
_yaml_user() {
  local v
  [ -f "$1" ] || return 1
  v="$(awk -v host="$2" '
    { sub(/\r$/, ""); match($0, /^[ \t]*/); ind = RLENGTH; t = substr($0, ind + 1) }
    t == "" || t ~ /^#/ { next }
    inb && ind <= hind { inb = 0 }
    !inb && t == host ":" { inb = 1; hind = ind; cind = -1; next }
    inb {
      if (cind < 0) cind = ind
      if (ind == cind && t ~ /^user:/) {
        v = substr(t, 6); sub(/[ \t]+#.*$/, "", v); gsub(/^[ \t"\x27]+|[ \t"\x27]+$/, "", v); print "u " v; exit
      }
    }' "$1" 2>/dev/null)"
  v="${v#u }"
  [ -n "$v" ] || return 1
  REPLY="$v"
  case "$v" in
    gh[pousr]_*|github_pat_*|glpat-*|*[!A-Za-z0-9._-]*) REPLY="" ;;
  esac
  [ "${#v}" -le 39 ] || REPLY=""
  return 0
}

# _ssh_knows HOST: HOST appears in ~/.ssh/config (Host/HostName) or un-hashed in known_hosts
_ssh_knows() {
  local h="$1"
  if [ -f "$HOME/.ssh/config" ] && awk -v h="$h" '
      { sub(/\r$/, ""); k = tolower($1) }
      (k == "host" || k == "hostname") { for (i = 2; i <= NF; i++) if (tolower($i) == h) f = 1 }
      END { exit !f }' "$HOME/.ssh/config" 2>/dev/null; then
    return 0
  fi
  [ -f "$HOME/.ssh/known_hosts" ] && awk -v h="$h" '
      { sub(/\r$/, "") }
      substr($1, 1, 1) == "|" { next }
      { n = split(tolower($1), a, ",")
        for (i = 1; i <= n; i++) if (a[i] == h || index(a[i], "[" h "]:") == 1) f = 1 }
      END { exit !f }' "$HOME/.ssh/known_hosts" 2>/dev/null
}

# _accounts: one "account" line per hosting service; the first source that matches wins
_accounts() {
  local svc host src name cfg gitcfg
  gitcfg="$(git config --global --get-regexp '^url\.|^credential\.' 2>/dev/null)"
  for svc in github gitlab codeberg; do
    src="" name=""
    case "$svc" in
      github) host=github.com
        if command -v gh >/dev/null 2>&1; then
          for cfg in "${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}/hosts.yml" \
                     "${APPDATA:+$APPDATA/GitHub CLI/hosts.yml}"; do
            [ -n "$cfg" ] && _yaml_user "$cfg" github.com && { src=gh; name="$REPLY"; break; }
          done
        fi ;;
      gitlab) host=gitlab.com
        if command -v glab >/dev/null 2>&1 &&
           _yaml_user "${XDG_CONFIG_HOME:-$HOME/.config}/glab-cli/config.yml" gitlab.com; then
          src=glab; name="$REPLY"
        fi ;;
      codeberg) host=codeberg.org ;;
    esac
    if [ -z "$src" ]; then
      if _ssh_knows "$host"; then
        src=ssh
      else
        case "$gitcfg" in
          *"//$host/"*|*"//$host:"*|*"@$host:"*|*"@$host/"*|*"//$host.helper"*|*"//$host.username"*|*"//$host.usehttppath"*)
            src=gitconfig ;;
        esac
      fi
    fi
    [ -n "$src" ] && printf 'account%s%s%s%s%s%s\n' "$TAB" "$svc" "$TAB" "$src" "$TAB" "$name"
  done
  return 0
}

# ---------------------------------------------------------------- init

cmd_init() {
  local dir="" own=0 top
  while [ $# -gt 0 ]; do
    case "$1" in
      --own) own=1 ;;
      -*) [ -d "$1" ] || usage_err "unknown option '$1'."
          [ -z "$dir" ] || usage_err "init takes at most one directory."; dir="$1" ;;
      *) [ -z "$dir" ] || usage_err "init takes at most one directory."; dir="$1" ;;
    esac
    shift
  done
  dir="${dir:-.}"
  [ -d "$dir" ] || fail 2 "'$dir' is not a directory." "create it or pass an existing directory."
  _absdir "$dir" || fail 2 "cannot enter '$dir'." "check its permissions."
  dir="$REPLY"
  if ack_git_refused "$dir"; then
    fail 3 "git refuses to read the repository at '$ACK_GIT_AT': $REPLY." \
      "run 'git -C \"$ACK_GIT_AT\" status' to see how git says to fix it; nothing was changed."
  fi
  if _same_dir "$dir" "$HOME"; then
    fail 2 "'$dir' is your home folder, which is no project." \
      "create a folder for the project and run ack-repo init there."
  fi
  if _where "$dir"; then
    top="$REPLY"
    case "$WHERE" in
      ok) printf 'git%sok%s%s\n' "$TAB" "$TAB" "$top"; return 0 ;;
      home) [ "$own" = 1 ] || { printf 'git%shome%s%s\n' "$TAB" "$TAB" "$top"; return 0; } ;;
      *) [ "$own" = 1 ] || { printf 'git%sinside%s%s\n' "$TAB" "$TAB" "$top"; return 0; } ;;
    esac
    # --own: a repository of its own inside the other one, unless that one tracks files here
    if [ -n "$(CDPATH= cd -- "$dir" 2>/dev/null && git ls-files 2>/dev/null | head -n 1)" ]; then
      fail 3 "the repository at '$top' already tracks files in '$dir'." \
        "a repository of its own would split them off: ask the user where they belong; nothing was changed."
    fi
  elif git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    # a bare repository or a .git directory has no work tree but is a repository all the same
    printf 'git%sok%s%s\n' "$TAB" "$TAB" "$dir"
    return 0
  fi
  git init -q "$dir" >/dev/null 2>&1 && git -C "$dir" symbolic-ref HEAD refs/heads/main >/dev/null 2>&1 ||
    fail 1 "git init failed in '$dir'." "check that the directory is writable."
  if [ ! -e "$dir/.gitignore" ] && [ ! -L "$dir/.gitignore" ]; then
    printf '%s\n' '.claude/settings.local.json' '.env' '*.key' > "$dir/.gitignore" ||
      fail 1 "cannot write '$dir/.gitignore'." "check that the directory is writable."
  fi
  printf 'git%screated%s%s\n' "$TAB" "$TAB" "$dir"
}

# ---------------------------------------------------------------- disk-remote

cmd_disk_remote() {
  local target="" name="" dir="." explicit=0 top ptop ptarget bare repo branch ok
  while [ $# -gt 0 ]; do
    case "$1" in
      --name) [ $# -ge 2 ] || usage_err "--name needs a value."; name="$2"; explicit=1; shift 2 ;;
      --dir) [ $# -ge 2 ] || usage_err "--dir needs a value."; dir="$2"; shift 2 ;;
      -*) usage_err "unknown option '$1'." ;;
      *) [ -z "$target" ] || usage_err "disk-remote takes one target directory."; target="$1"; shift ;;
    esac
  done
  [ -n "$target" ] || usage_err "disk-remote needs a target directory."
  [ -d "$dir" ] || fail 2 "'$dir' is not a directory." "pass the repository with --dir."
  _toplevel "$dir" || fail 2 "'$dir' is not a git repository." "run ack-repo init first."
  top="$REPLY"
  [ -d "$target" ] || fail 2 "the target '$target' does not exist." "mount or create it, then run ack-repo again."
  [ -w "$target" ] || fail 2 "the target '$target' is not writable." "check the permissions or the mount."
  _physdir "$top" && ptop="$REPLY" || ptop="$top"
  _physdir "$target" && ptarget="$REPLY" || fail 2 "cannot enter '$target'." "check its permissions."
  case "$ptarget/" in
    "$ptop"/*) fail 2 "the target '$target' lies inside the repository." "pick a directory outside '$top'." ;;
  esac
  _absdir "$target" && target="$REPLY"
  repo="${top##*/}"
  bare="$target/$repo.git"
  if [ -e "$bare" ] || [ -L "$bare" ]; then
    fail 3 "'$bare' already exists." "pick another target or remove it yourself; nothing was changed."
  fi
  if [ "$explicit" = 0 ]; then
    name=origin
    if git -C "$top" remote | grep -Fxq origin; then
      name=backup
    fi
  fi
  case "$name" in
    ''|-*) ok=1 ;;
    *) git check-ref-format "refs/remotes/$name/x" >/dev/null 2>&1; ok=$? ;;
  esac
  [ "$ok" = 0 ] || fail 2 "'$name' cannot be the name of a remote." \
    "pass a name of letters, digits and dashes with --name, such as --name usb."
  if git -C "$top" remote | grep -Fxq -- "$name"; then
    fail 3 "the remote '$name' already exists." "pick another name with --name; nothing was changed."
  fi
  git init -q --bare "$bare" >/dev/null 2>&1 ||
    fail 1 "cannot create '$bare'." "check that the target is writable."
  branch="$(git -C "$top" symbolic-ref -q HEAD 2>/dev/null)" || branch=""
  [ -n "$branch" ] && git --git-dir="$bare" symbolic-ref HEAD "$branch" >/dev/null 2>&1
  if ! git -C "$top" remote add "$name" "$bare" >/dev/null 2>&1; then
    rm -rf "$bare"
    fail 1 "cannot add the remote '$name'." "check the repository's config."
  fi
  printf 'remote%screated%s%s%s%s\n' "$TAB" "$TAB" "$name" "$TAB" "$bare"
  if ! git -C "$top" rev-parse --verify -q HEAD >/dev/null 2>&1; then
    printf 'push%sskipped%sno commit yet\n' "$TAB" "$TAB"
    return 0
  fi
  if git -C "$top" push -q "$name" --all >/dev/null 2>&1; then
    printf 'push%sok%sall branches\n' "$TAB" "$TAB"
  else
    fail 1 "the push to '$bare' failed." "run: git -C '$top' push $name --all"
  fi
}

main() {
  [ $# -gt 0 ] || usage_err "missing subcommand."
  local sub="$1"
  shift
  case "$sub" in
    inspect) cmd_inspect "$@" ;;
    init) cmd_init "$@" ;;
    disk-remote) cmd_disk_remote "$@" ;;
    -h|--help|help) _help; exit 0 ;;
    *) usage_err "unknown subcommand '$sub'." ;;
  esac
}
main "$@"
