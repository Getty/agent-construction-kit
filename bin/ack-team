#!/usr/bin/env bash
# ack-team: check a finished agent team in a repository. Read only.
#   ack-team check [DIR]
# DIR defaults to the current directory. One finding per line, four fields separated by
# tabs (the last may be empty, its tab stays):
#   WHAT<TAB>ok|missing|warn<TAB>FILE-OR-NAME<TAB>TEXT
# WHAT is one of:
#   agent      per *.md below .claude/agents (subdirectories included; a leading ".local."
#              is dropped from the file name, so .local.x.md must say "x"): frontmatter
#              (a BOM is fine), name, description, briefing.skills (warn: no briefing;
#              missing: a flow list that spans lines), allowed-tools (missing: Claude Code
#              ignores it), a top-level skills key (warn: briefing reads only
#              briefing.skills). No agent file at all: missing .claude/agents.
#   skill      per distinct briefing.skills entry that resolves: ok; per agent that
#              declares an entry that does not: missing (briefing would refuse the spawn).
#              A name resolves in .claude/skills, ~/.claude/skills or, as "plugin:skill"
#              or bare, in a plugin that is installed (installed_plugins.json, in the
#              installed version's directory) and enabled (enabledPlugins, user, project,
#              project-local settings), like the briefing hook decides.
#   roles      ok when agents ending in -scout, -worker (or -worker-*), -test-writer and
#              -reviewer all exist; else warn per missing role.
#   readonly   per agent ending in -scout, -reviewer, -checker or -coordinator: warn
#              unless its disallowedTools name Edit and Write.
#   rules      missing without a *.md file in .claude/rules/.
#   settings   .claude/settings.json is readable, every plugin set to true in
#              enabledPlugins has its marketplace in extraKnownMarketplaces
#              (claude-plugins-official excepted), briefing is enabled; missing otherwise.
#   board      ok with karr refs (refs/karr/*) or a BOARD.md with the headings Todo,
#              In progress, Review, Done (each the heading's whole text, outside code
#              fences; warn when one is absent); else missing.
#   claude-md  warn unless CLAUDE.md exists and names every agent (as a whole name).
#   git        missing without a repository; warn without a remote.
#   hook       runs the briefing plugin's hook once per agent as if it were spawned: a
#              denial is missing (the reason is the text). The first worker (else the
#              first agent) must also be briefed: ok, missing when the hook hands it an
#              abort text, warn when it adds nothing. A hook that is not found, cannot be
#              run, fails or does not answer within ACK_HOOK_WAIT seconds (default 10) is
#              one warn. ACK_BRIEFING_HOOK names the hook script instead of the cache's.
# Exit codes: 0 no line is missing, 1 a line is missing, 2 usage error or unusable DIR.
# Errors are two lines on stderr: "ack-team: <what>" and "ack-team: <what to do>".

_help() {
  local n=0 line
  while IFS= read -r line; do
    n=$((n + 1))
    [ "$n" -ge 2 ] || continue
    case "$line" in '#'*) line="${line#\#}"; printf '%s\n' "${line# }" ;; *) break ;; esac
  done < "$_self"
}

# Git for Windows may hand over a backslash path (bash 'D:\x\ack-team').
_slashes() { case "$OSTYPE" in msys*|cygwin*) REPLY="${1//\\//}" ;; *) REPLY="$1" ;; esac; }
_slashes "${BASH_SOURCE[0]}"; _self="$REPLY"
_src="$_self"
while [ -L "$_src" ]; do
  _slashes "$(readlink "$_src")"; _t="$REPLY"
  case "$_t" in
    /*) _src="$_t" ;;
    *) case "$_src" in */*) _src="${_src%/*}/$_t" ;; *) _src="./$_t" ;; esac ;;
  esac
done
case "$_src" in */*) _dir="${_src%/*}" ;; *) _dir="." ;; esac
if ! SHARE="$(cd "$_dir/../share" 2>/dev/null && pwd)"; then
  echo "ack-team: cannot find the share directory next to bin/." >&2
  echo "ack-team: reinstall agent-construction-kit." >&2
  exit 2
fi
# shellcheck source=../share/lib.sh
. "$SHARE/lib.sh" || exit 2

TAB=$'\t'
RC=0
MARKER="ACK-CHECK-MARKER"

fail() {
  echo "ack-team: $2" >&2
  echo "ack-team: $3" >&2
  exit "$1"
}
usage_err() {
  fail 2 "$1" "usage: ack-team check [DIR] (see the header of $0)."
}

# emit WHAT STATUS NAME [TEXT]: one finding; tabs and line ends in TEXT become spaces.
emit() {
  local t="${4:-}"
  t="${t//$'\t'/ }"; t="${t//$'\r'/}"; t="${t//$'\n'/ }"
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$t"
  [ "$2" = missing ] && RC=1
  return 0
}

# _lower STRING -> REPLY
_lower() { REPLY="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"; }

# _unquote VALUE -> REPLY: trimmed; "x" and 'x' lose their quotes; an unquoted value
# loses a trailing " # comment"
_unquote() {
  _ack_trim "$1"
  case "$REPLY" in
    \"*) REPLY="${REPLY#\"}"; REPLY="${REPLY%%\"*}" ;;
    \'*) REPLY="${REPLY#\'}"; REPLY="${REPLY%%\'*}" ;;
    *) REPLY="${REPLY%%[ $TAB]\#*}"; _ack_trim "$REPLY" ;;
  esac
}

# parse_agent FILE: sets A_FM (1 = has frontmatter), A_HASNAME, A_NAME, A_DESC (1 = a
# description with text), A_SKILLS (newline separated briefing.skills), A_BADLIST (1 =
# a flow list that does not close on its line), A_ALLOWED, A_TOPSKILLS, A_DIS (the
# disallowedTools text). Only the frontmatter is read: the lines between a first line
# "---" (a UTF-8 BOM before it is fine) and the next "---".
parse_agent() {
  local f="$1" line t first=1 mode="" bsk=0 bind=-1 ind val item rest
  A_FM=0 A_HASNAME=0 A_NAME="" A_DESC=0 A_SKILLS="" A_BADLIST=0 A_ALLOWED=0 A_TOPSKILLS=0 A_DIS=""
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line//$'\r'/}"
    if [ "$first" = 1 ]; then line="${line#$'\xEF\xBB\xBF'}"; fi
    _ack_trim "$line"; t="$REPLY"
    if [ "$first" = 1 ]; then
      first=0
      [ "$t" = "---" ] || return 0
      A_FM=1
      continue
    fi
    [ "$t" = "---" ] && return 0
    case "$t" in ''|'#'*) continue ;; esac
    case "$line" in
      ' '*|"$TAB"*)
        ind="${line%%[![:space:]]*}"
        case "$mode" in
          desc) A_DESC=1 ;;
          dis) A_DIS="$A_DIS $t" ;;
          briefing)
            [ "$bind" = -1 ] && bind="${#ind}"
            case "$t" in
              skills:*)
                if [ "${#ind}" != "$bind" ]; then bsk=0; continue; fi
                _ack_trim "${t#skills:}"; val="$REPLY"
                bsk=0
                case "$val" in
                  '['*)
                    case "$val" in
                      *']'*) ;;
                      *) A_BADLIST=1; continue ;;
                    esac
                    val="${val#\[}"; val="${val%%\]*}"
                    while [ -n "$val" ]; do
                      item="${val%%,*}"
                      case "$val" in *,*) val="${val#*,}" ;; *) val="" ;; esac
                      _unquote "$item"
                      [ -z "$REPLY" ] || A_SKILLS="$A_SKILLS$REPLY"$'\n'
                    done ;;
                  ''|'#'*) bsk=1 ;;
                esac ;;
              -*)
                if [ "$bsk" = 1 ]; then
                  rest="${t#-}"
                  _unquote "$rest"
                  [ -z "$REPLY" ] || A_SKILLS="$A_SKILLS$REPLY"$'\n'
                fi ;;
              *) bsk=0 ;;
            esac ;;
        esac ;;
      *)
        if [ "$mode" = dis ]; then
          case "$t" in -*) A_DIS="$A_DIS $t"; continue ;; esac
        fi
        if [ "$mode" = briefing ] && [ "$bsk" = 1 ]; then
          case "$t" in -*)
            _unquote "${t#-}"
            [ -z "$REPLY" ] || A_SKILLS="$A_SKILLS$REPLY"$'\n'
            continue ;;
          esac
        fi
        mode=""
        case "$t" in
          *:*) ;;
          *) continue ;;
        esac
        _ack_trim "${t%%:*}"; item="$REPLY"
        _ack_trim "${t#*:}"; val="$REPLY"
        case "$item" in
          name) A_HASNAME=1; _unquote "$val"; A_NAME="$REPLY" ;;
          description)
            case "$val" in
              ''|'#'*|'>'*|'|'*) mode=desc ;;
              *) _unquote "$val"; [ -z "$REPLY" ] || A_DESC=1 ;;
            esac ;;
          allowed-tools) A_ALLOWED=1 ;;
          skills) A_TOPSKILLS=1 ;;
          disallowedTools) A_DIS="$val"; mode=dis ;;
          briefing) mode=briefing; bsk=0; bind=-1 ;;
        esac ;;
    esac
  done < "$f"
  return 0
}

# _has_word TEXT WORD: WORD stands in TEXT between non-letters
_has_word() {
  local t
  t="$(printf '%s' "$1" | tr -c 'A-Za-z' ' ')"
  case " $t " in *" $2 "*) return 0 ;; esac
  return 1
}

# _safe_name NAME: fit to be a path part (no glob characters, no slash, not empty)
_safe_name() {
  case "$1" in ''|*[\*\?\[\]/\\]*) return 1 ;; esac
  return 0
}

# _unescape STRING -> REPLY: the few JSON escapes a path holds
_unescape() {
  REPLY="${1//\\\\/\\}"
  REPLY="${REPLY//\\\//\/}"
}

# _enabled_map -> ENABLED: lines "KEY<TAB>true|false", user then project then
# project-local settings, a later file winning per key; only literal true and false count
_enabled_map() {
  local f text ep k v
  ENABLED=""
  for f in "$HOME/.claude/settings.json" "$DIR/.claude/settings.json" "$DIR/.claude/settings.local.json"; do
    [ -f "$f" ] || continue
    text="$(cat "$f" 2>/dev/null)"
    json_member "$text" enabledPlugins; ep="$REPLY"
    _json_keys "$ep"
    while IFS="$TAB" read -r k v; do
      case "$v" in true|false) ;; *) continue ;; esac
      [ -n "$k" ] || continue
      ENABLED="$ENABLED$k$TAB$v"$'\n'
    done <<EOT
$VALS
EOT
  done
}

# _enabled KEY: the last entry for KEY in ENABLED says true
_enabled() {
  local k v r=1
  while IFS="$TAB" read -r k v; do
    [ "$k" = "$1" ] && { [ "$v" = true ] && r=0 || r=1; }
  done <<EOT
$ENABLED
EOT
  return "$r"
}

# _installed_entries FILE: one line KEY<TAB>installPath<TAB>projectPath per entry of
# the "plugins" object of installed_plugins.json (a 150 KB file on a busy machine, so
# an awk scan, not a shell loop); strings keep their JSON escapes
_installed_entries() {
  awk 'BEGIN { RS = "\001" }
  {
    s = $0; n = length(s); depth = 0; i = 1
    while (i <= n) {
      c = substr(s, i, 1)
      if (c == "\"") {
        j = i + 1; str = ""
        while (j <= n) {
          d = substr(s, j, 1)
          if (d == "\\") { str = str substr(s, j, 2); j += 2; continue }
          if (d == "\"") break
          str = str d; j++
        }
        i = j + 1
        if (ctx[depth] == "o" && expectkey[depth]) { key[depth] = str; expectkey[depth] = 0 }
        else if (depth == 4 && key[1] == "plugins") {
          if (key[4] == "installPath") ip = str
          else if (key[4] == "projectPath") pp = str
        }
        continue
      }
      if (c == "{" || c == "[") {
        depth++; ctx[depth] = (c == "{") ? "o" : "a"; expectkey[depth] = (c == "{")
        if (depth == 4) { ip = ""; pp = "" }
      } else if (c == "}" || c == "]") {
        if (depth == 4 && key[1] == "plugins" && ip != "") printf "%s\t%s\t%s\n", key[2], ip, pp
        depth--
      } else if (c == ",") {
        if (ctx[depth] == "o") expectkey[depth] = 1
      }
      i++
    }
  }' "$1" 2>/dev/null
}

# _under PROJECT: DIR lies in PROJECT, also when one of them goes through a symlink
# (macOS temp directories do)
_under() {
  local p="$1" real
  case "$DIR/" in "$p"/*) return 0 ;; esac
  case "$DIRP/" in "$p"/*) return 0 ;; esac
  real="$(cd "$p" 2>/dev/null && pwd -P)" || return 1
  case "$DIRP/" in "$real"/*) return 0 ;; esac
  return 1
}

# _plugin_list -> PLUGINS: lines "NAME<TAB>ROOT" for every plugin installed (per
# ~/.claude/plugins/installed_plugins.json, for this project) AND enabled, like the
# briefing hook reads them; computed once
_plugin_list() {
  local idx="$HOME/.claude/plugins/installed_plugins.json" key root proj name mf
  [ -z "${PLUGINS_DONE:-}" ] || return 0
  PLUGINS_DONE=1; PLUGINS=""
  [ -f "$idx" ] || return 0
  _enabled_map
  while IFS="$TAB" read -r key root proj; do
    [ -n "$key" ] || continue
    _enabled "$key" || continue
    _unescape "$root"; root="$REPLY"
    if [ -n "$proj" ]; then
      _unescape "$proj"; proj="${REPLY%/}"
      if ! _under "$proj"; then continue; fi
    fi
    name="${key%%@*}"
    mf="$root/.claude-plugin/plugin.json"
    if [ -f "$mf" ]; then
      json_member "$(cat "$mf" 2>/dev/null)" name
      case "$REPLY" in '"'*'"') name="${REPLY#\"}"; name="${name%\"}" ;; esac
    fi
    PLUGINS="$PLUGINS$name$TAB$root"$'\n'
  done <<EOT
$(_installed_entries "$idx")
EOT
}

# _plugin_has_skill ROOT SKILL: the plugin at ROOT holds the skill: skills/SKILL/SKILL.md,
# or at a path the manifest's "skills" lists (each one a skill directory or a directory
# of them, like ./skills/engineering/tdd), as the briefing hook reads it
_plugin_has_skill() {
  local root="$1" skill="$2" mf="$1/.claude-plugin/plugin.json" raw p
  [ -f "$root/skills/$skill/SKILL.md" ] && return 0
  [ -f "$mf" ] || return 1
  json_member "$(cat "$mf" 2>/dev/null)" skills
  raw="$(printf '%s' "$REPLY" | tr -d '[]\r\n' | tr ',' '\n')"
  while IFS= read -r p; do
    _ack_trim "$p"; p="$REPLY"
    case "$p" in '"'*'"') p="${p#\"}"; p="${p%\"}" ;; *) continue ;; esac
    _unescape "$p"; p="$REPLY"
    p="${p#./}"; p="${p%/}"
    case "$p" in ''|/*|..|../*|*/..|*/../*) continue ;; esac
    [ "${p##*/}" = "$skill" ] && [ -f "$root/$p/SKILL.md" ] && return 0
    [ -f "$root/$p/$skill/SKILL.md" ] && return 0
  done <<EOT
$raw
EOT
  return 1
}

# _resolves NAME -> WHY (empty on success): the skill exists where the briefing hook
# looks: the project's and the user's .claude/skills, and the skills directory of every
# plugin that is installed and enabled (in the installed version's directory)
_resolves() {
  local n="$1" plugin skill name root known=0
  WHY=""
  case "$n" in
    *:*)
      plugin="${n%%:*}"; skill="${n#*:}"
      if ! _safe_name "$plugin" || ! _safe_name "$skill"; then WHY="not a usable skill name"; return 1; fi
      _plugin_list
      while IFS="$TAB" read -r name root; do
        [ "$name" = "$plugin" ] || continue
        known=1
        _plugin_has_skill "$root" "$skill" && return 0
      done <<EOT
$PLUGINS
EOT
      if [ "$known" = 1 ]; then WHY="plugin '$plugin' has no skill '$skill'"
      else WHY="plugin '$plugin' is not installed and enabled"; fi
      return 1 ;;
  esac
  if ! _safe_name "$n"; then WHY="not a usable skill name"; return 1; fi
  [ -f "$DIR/.claude/skills/$n/SKILL.md" ] && return 0
  [ -f "$HOME/.claude/skills/$n/SKILL.md" ] && return 0
  _plugin_list
  while IFS="$TAB" read -r name root; do
    [ -n "$root" ] || continue
    _plugin_has_skill "$root" "$n" && return 0
  done <<EOT
$PLUGINS
EOT
  WHY="no such skill in .claude/skills, ~/.claude/skills or an installed and enabled plugin"
  return 1
}

# ---------------------------------------------------------------- agents

# Agent files are every *.md below .claude/agents, subdirectories included. The name
# that must stand in the file is the file name without ".md" and without one leading
# ".local." (skilletor installs ".local.<name>.md"); "x.local.md" must say "x.local".
check_agents() {
  local f rel base pairs="" s list
  AG_NAMES=()      # expected names, in file order
  AG_DIS=()        # their disallowedTools text
  AG_FM=()         # 1 when the file has frontmatter
  AG_FILES=()      # their paths below .claude/agents
  list="$(find "$DIR/.claude/agents" -type f -name '*.md' -print 2>/dev/null | LC_ALL=C sort)"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rel="${f#"$DIR/.claude/agents/"}"
    base="${rel##*/}"; base="${base%.md}"
    case "$base" in .local.?*) base="${base#.local.}" ;; esac
    AG_NAMES[${#AG_NAMES[@]}]="$base"
    AG_FILES[${#AG_FILES[@]}]="$rel"
    parse_agent "$f"
    AG_DIS[${#AG_DIS[@]}]="$A_DIS"
    AG_FM[${#AG_FM[@]}]="$A_FM"
    if [ "$A_FM" = 0 ]; then
      emit agent missing "$rel" "no frontmatter"
      continue
    fi
    local bad=0
    if [ "$A_HASNAME" = 0 ] || [ -z "$A_NAME" ]; then
      emit agent missing "$rel" "no name"; bad=1
    elif [ "$A_NAME" != "$base" ]; then
      emit agent missing "$rel" "name '$A_NAME' differs from the file name"; bad=1
    fi
    if [ "$A_DESC" = 0 ]; then
      emit agent missing "$rel" "description is empty"; bad=1
    fi
    if [ "$A_ALLOWED" = 1 ]; then
      emit agent missing "$rel" "allowed-tools: ignored by Claude Code; use disallowedTools"; bad=1
    fi
    if [ "$A_BADLIST" = 1 ]; then
      emit agent missing "$rel" 'briefing.skills is not readable (keep the list on one line or use one "- name" per line)'; bad=1
    elif [ -z "$A_SKILLS" ]; then
      emit agent warn "$rel" "no briefing"; bad=1
    fi
    if [ "$A_TOPSKILLS" = 1 ]; then
      emit agent warn "$rel" "skills: briefing reads only briefing.skills"; bad=1
    fi
    [ "$bad" = 1 ] || emit agent ok "$rel" ""
    while IFS= read -r s; do
      [ -z "$s" ] || pairs="$pairs$rel$TAB$s"$'\n'
    done <<EOT
$A_SKILLS
EOT
  done <<EOT
$list
EOT
  if [ "${#AG_NAMES[@]}" = 0 ]; then
    emit agent missing ".claude/agents" "no agent files"
  fi
  check_skills "$pairs"
}

# check_skills PAIRS: PAIRS holds "AGENT-FILE<TAB>SKILL" lines
check_skills() {
  local pairs="$1" seen=$'\n' a s a2 s2
  while IFS="$TAB" read -r a s; do
    [ -n "$s" ] || continue
    case "$seen" in *$'\n'"$s"$'\n'*) continue ;; esac
    seen="$seen$s"$'\n'
    if _resolves "$s"; then
      emit skill ok "$s" ""
    else
      while IFS="$TAB" read -r a2 s2; do
        [ "$s2" = "$s" ] || continue
        emit skill missing "$s" "$a2 declares it; $WHY; briefing would refuse the spawn"
      done <<EOT
$pairs
EOT
    fi
  done <<EOT
$pairs
EOT
}

_role_match() { # NAME ROLE
  case "$1" in
    *-"$2") return 0 ;;
  esac
  [ "$2" = worker ] && case "$1" in *-worker-?*) return 0 ;; esac
  return 1
}

check_roles() {
  local role n i missing=0
  [ "${#AG_NAMES[@]}" -gt 0 ] || return 0
  for role in scout worker test-writer reviewer; do
    n=0
    for ((i = 0; i < ${#AG_NAMES[@]}; i++)); do
      _role_match "${AG_NAMES[$i]}" "$role" && n=1
    done
    if [ "$n" = 0 ]; then
      emit roles warn "$role" "no agent ending in -$role"
      missing=1
    fi
  done
  [ "$missing" = 1 ] || emit roles ok ".claude/agents" ""
}

check_readonly() {
  local i name role ro
  for ((i = 0; i < ${#AG_NAMES[@]}; i++)); do
    name="${AG_NAMES[$i]}"
    ro=0
    for role in scout reviewer checker coordinator; do
      _role_match "$name" "$role" && ro=1
    done
    [ "$ro" = 1 ] && [ "${AG_FM[$i]}" = 1 ] || continue
    if _has_word "${AG_DIS[$i]}" Edit && _has_word "${AG_DIS[$i]}" Write; then
      emit readonly ok "${AG_FILES[$i]}" ""
    else
      emit readonly warn "${AG_FILES[$i]}" "read-only role without disallowedTools naming Edit and Write"
    fi
  done
}

# ---------------------------------------------------------------- rules, settings

check_rules() {
  local hit=""
  if [ -d "$DIR/.claude/rules" ]; then
    hit="$(find "$DIR/.claude/rules" -type f -name '*.md' -print 2>/dev/null | head -n 1)"
  fi
  if [ -n "$hit" ]; then
    emit rules ok ".claude/rules" ""
  else
    emit rules missing ".claude/rules" "no rule files"
  fi
}

# _json_keys OBJECT-TEXT -> KEYS (newline wrapped), VALS (lines KEY<TAB>VALUE)
_json_keys() {
  local s k v rest
  KEYS=$'\n' VALS=""
  case "$1" in '{'*) ;; *) return 0 ;; esac
  json_objects "[$1]"
  s="${PLUGIN_OBJS%%$'\n'*}"
  while :; do
    while [ "${s:0:1}" = "," ]; do s="${s:1}"; done
    case "$s" in '"'*) ;; *) break ;; esac
    rest="${s#\"}"
    k="${rest%%\"*}"
    s="${rest#*\":}"
    v="${s%%,\"*}"
    s="${s#"$v"}"
    v="${v%,}"
    KEYS="$KEYS$k"$'\n'
    VALS="$VALS$k$TAB$v"$'\n'
  done
}

check_settings() {
  local f="$DIR/.claude/settings.json" text ep mk k v market briefing=0 bad=0 markets
  local name=".claude/settings.json"
  if [ ! -f "$f" ] || ! text="$(cat "$f" 2>/dev/null)"; then
    emit settings missing "$name" "not found or not readable"
    return 0
  fi
  case "$text" in
    *'{'*) ;;
    *) emit settings missing "$name" "not a JSON object"; return 0 ;;
  esac
  json_member "$text" enabledPlugins; ep="$REPLY"
  json_member "$text" extraKnownMarketplaces; mk="$REPLY"
  _json_keys "$mk"; markets="$KEYS"
  _json_keys "$ep"
  while IFS="$TAB" read -r k v; do
    [ -n "$k" ] || continue
    [ "$v" = true ] || continue
    case "$k" in
      briefing@*) briefing=1 ;;
    esac
    case "$k" in
      *@*)
        market="${k##*@}"
        if [ "$market" != claude-plugins-official ]; then
          case "$markets" in
            *$'\n'"$market"$'\n'*) ;;
            *) emit settings missing "$k" "marketplace '$market' is not in extraKnownMarketplaces"; bad=1 ;;
          esac
        fi ;;
    esac
  done <<EOT
$VALS
EOT
  if [ "$briefing" = 0 ]; then
    emit settings missing "briefing" "the briefing plugin is not enabled in enabledPlugins"
    bad=1
  fi
  [ "$bad" = 1 ] || emit settings ok "$name" ""
}

# ---------------------------------------------------------------- board, claude-md, git

check_board() {
  local line t todo=0 prog=0 rev=0 done_=0 fence=0 miss="" have_karr=""
  if [ -n "$GITTOP" ]; then
    have_karr="$(git -C "$DIR" for-each-ref --count=1 refs/karr 2>/dev/null)"
  fi
  if [ -n "$have_karr" ]; then
    emit board ok karr ""
    return 0
  fi
  if [ ! -f "$DIR/BOARD.md" ]; then
    emit board missing "BOARD.md" "no karr refs and no BOARD.md"
    return 0
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line//$'\r'/}"
    _ack_trim "$line"; t="$REPLY"
    case "$t" in
      '```'*|'~~~'*) [ "$fence" = 1 ] && fence=0 || fence=1; continue ;;
    esac
    [ "$fence" = 0 ] || continue
    case "$line" in '#'*) ;; *) continue ;; esac
    t="${line#"${line%%[!#]*}"}"
    t="$(printf '%s' "$t" | tr -d '*`')"
    _ack_trim "$t"; t="$REPLY"
    t="${t%"${t##*[!#]}"}"
    _ack_trim "$t"; t="$REPLY"
    t="${t#"${t%%[!_]*}"}"; t="${t%"${t##*[!_]}"}"
    _lower "$t"
    case "$REPLY" in
      todo) todo=1 ;;
      "in progress") prog=1 ;;
      review) rev=1 ;;
      done) done_=1 ;;
    esac
  done < "$DIR/BOARD.md"
  [ "$todo" = 1 ] || miss="$miss, Todo"
  [ "$prog" = 1 ] || miss="$miss, In progress"
  [ "$rev" = 1 ] || miss="$miss, Review"
  [ "$done_" = 1 ] || miss="$miss, Done"
  if [ -z "$miss" ]; then
    emit board ok "BOARD.md" ""
  else
    emit board warn "BOARD.md" "no heading for: ${miss#, }"
  fi
}

check_claude_md() {
  local n rx bad=0
  if [ ! -f "$DIR/CLAUDE.md" ]; then
    emit claude-md warn "CLAUDE.md" "not found"
    return 0
  fi
  for n in "${AG_NAMES[@]}"; do
    # the name stands between characters that are no part of a name, or at a line end
    rx="$(printf '%s' "$n" | sed 's/[][\.*^$+?(){}|/]/\\&/g')"
    if ! grep -E -- "(^|[^A-Za-z0-9_-])$rx([^A-Za-z0-9_-]|\$)" "$DIR/CLAUDE.md" >/dev/null 2>&1; then
      emit claude-md warn "CLAUDE.md" "does not name the agent $n"
      bad=1
    fi
  done
  [ "$bad" = 1 ] || emit claude-md ok "CLAUDE.md" ""
}

check_git() {
  if [ -z "$GITTOP" ]; then
    emit git missing "." "not a git repository"
  elif [ -z "$(git -C "$DIR" remote 2>/dev/null)" ]; then
    emit git warn "." "no remote: the history exists only on this machine"
  else
    emit git ok "." ""
  fi
}

# ---------------------------------------------------------------- hook

# _json_escape STRING -> REPLY
_json_escape() {
  REPLY="${1//\\/\\\\}"
  REPLY="${REPLY//\"/\\\"}"
}

# _find_hook -> REPLY: ACK_BRIEFING_HOOK, else the newest briefing-preload in the cache
_find_hook() {
  REPLY=""
  if [ -n "${ACK_BRIEFING_HOOK:-}" ]; then
    REPLY="$ACK_BRIEFING_HOOK"
    return 0
  fi
  REPLY="$(ls -td -- "$HOME"/.claude/plugins/cache/*/briefing/*/hooks/briefing-preload 2>/dev/null | head -n 1)"
  return 0
}

# _deny_reason OUTPUT -> REPLY: the permissionDecisionReason string, unescaped a little
_deny_reason() {
  local r="${1#*\"permissionDecisionReason\"}" acc="" pre
  r="${r#*:}"
  _ack_trim "$r"; r="${REPLY#\"}"
  while :; do
    pre="${r%%\"*}"
    if [ "$pre" = "$r" ]; then acc="$acc$pre"; break; fi
    case "$pre" in
      *\\) acc="${acc}${pre%\\}\""; r="${r#*\"}" ;;
      *) acc="$acc$pre"; break ;;
    esac
  done
  acc="${acc//\\n/ }"; acc="${acc//\\t/ }"; acc="${acc//\\\\/\\}"
  REPLY="$acc"
}

# _hook_run HOOK INPUT: feeds INPUT to the hook on stdin, waiting at most ACK_HOOK_WAIT
# seconds (default 10). Sets HR_STATE (ok | timeout | noexec | fail), HR_OUT (stdout) and
# HR_ERR (the first line of stderr).
_hook_run() {
  local hook="$1" input="$2" secs="${ACK_HOOK_WAIT:-10}" d rc
  HR_STATE=ok HR_OUT="" HR_ERR=""
  case "$secs" in ''|*[!0-9]*) secs=10 ;; esac
  if [ ! -x "$hook" ] || ! d="$(mktemp -d)"; then HR_STATE=noexec; return 0; fi
  printf '%s\n' "$input" > "$d/in"
  ack_run_bounded "$secs" sh -c 'exec "$1" < "$2"' sh "$hook" "$d/in"
  rc=$?
  rm -rf "$d"
  HR_OUT="$ACK_BOUNDED_OUT"; HR_ERR="$ACK_BOUNDED_ERR"
  case "$rc" in
    0) ;;
    124) HR_STATE=timeout ;;
    126|127) HR_STATE=noexec ;;
    *) HR_STATE=fail ;;
  esac
  return 0
}

# _hook_trouble AGENT: after a failed _hook_run, print the warn line; returns 1 when
# there was trouble
_hook_trouble() {
  case "$HR_STATE" in
    ok) return 1 ;;
    timeout) emit hook warn "$1" "the hook did not answer" ;;
    noexec) emit hook warn "$1" "the hook could not be run" ;;
    *) emit hook warn "$1" "${HR_ERR:-the hook could not be run}" ;;
  esac
  return 0
}

# check_hook: every agent goes through the hook's PreToolUse check (a denial is
# missing); the first worker (else the first agent) is also checked for being briefed.
# The first trouble with the hook itself ends the check, so a broken hook warns once.
check_hook() {
  local i w=-1 agent hook input out norm esc names bs="\\"
  [ "${#AG_NAMES[@]}" -gt 0 ] || return 0
  for ((i = 0; i < ${#AG_NAMES[@]}; i++)); do
    if _role_match "${AG_NAMES[$i]}" worker; then w="$i"; break; fi
  done
  [ "$w" -ge 0 ] || w=0
  _find_hook; hook="$REPLY"
  if [ -z "$hook" ] || [ ! -f "$hook" ]; then
    emit hook warn "${AG_NAMES[$w]}" "the briefing hook was not found; install the briefing plugin"
    return 0
  fi
  _json_escape "$DIR"; esc="$REPLY"
  for ((i = 0; i < ${#AG_NAMES[@]}; i++)); do
    agent="${AG_NAMES[$i]}"
    input="{\"hook_event_name\":\"PreToolUse\",\"session_id\":\"ack-check\",\"cwd\":\"$esc\",\"tool_name\":\"Agent\",\"tool_input\":{\"subagent_type\":\"$agent\",\"description\":\"check\",\"prompt\":\"$MARKER\"}}"
    _hook_run "$hook" "$input"
    ! _hook_trouble "$agent" || return 0
    out="$HR_OUT"
    norm="${out//[[:space:]]/}"
    case "$norm" in
      *'"permissionDecision":"deny"'*)
        _deny_reason "$out"
        emit hook missing "$agent" "${REPLY:-the hook denied the spawn}"
        continue ;;
    esac
    [ "$i" = "$w" ] || continue
    # An older hook briefs here: the prompt comes back longer, the marker inside.
    case "$out" in
      *"$MARKER"*)
        if [ "${#out}" -gt "${#input}" ]; then
          emit hook ok "$agent" ""
          continue
        fi ;;
    esac
    # The current hook only guards here and briefs when the subagent starts.
    input="{\"hook_event_name\":\"SubagentStart\",\"session_id\":\"ack-check\",\"cwd\":\"$esc\",\"agent_type\":\"$agent\"}"
    _hook_run "$hook" "$input"
    ! _hook_trouble "$agent" || return 0
    out="$HR_OUT"
    norm="${out//[[:space:]]/}"
    case "$out" in
      *"could not be loaded: "*)
        # the hook cannot deny at SubagentStart; it hands the agent an abort text instead
        names="${out#*could not be loaded: }"
        names="${names%%".${bs}n"*}"
        emit hook missing "$agent" "the hook reports skills that could not be loaded: $names"
        continue ;;
    esac
    case "$norm" in
      *'"additionalContext":"'[!\"]*) emit hook ok "$agent" "" ;;
      *) emit hook warn "$agent" "the hook briefs nothing for this agent" ;;
    esac
  done
}

# ---------------------------------------------------------------- main

cmd_check() {
  [ $# -le 1 ] || usage_err "check takes at most one directory."
  case "${1:-}" in -*) usage_err "unknown option '$1'." ;; esac
  DIR="$(cd "${1:-.}" 2>/dev/null && pwd)" && [ -n "$DIR" ] ||
    fail 2 "'${1:-.}' is not a directory." "pass the repository that holds the team."
  DIR="${DIR%/}"
  DIRP="$(cd "$DIR" && pwd -P)"
  GITTOP=""
  if command -v git >/dev/null 2>&1; then
    GITTOP="$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null)"
  fi
  check_agents
  check_roles
  check_readonly
  check_rules
  check_settings
  check_board
  check_claude_md
  check_git
  check_hook
  exit "$RC"
}

main() {
  [ $# -gt 0 ] || usage_err "missing subcommand."
  local sub="$1"
  shift
  case "$sub" in
    check) cmd_check "$@" ;;
    -h|--help|help) _help; exit 0 ;;
    *) usage_err "unknown subcommand '$sub'." ;;
  esac
}
main "$@"
