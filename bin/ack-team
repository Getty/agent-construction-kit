#!/usr/bin/env bash
# ack-team: check a finished agent team or resolve repository file ownership. It changes
# no file in DIR.
#   ack-team check [DIR]
#   ack-team owner [--dir DIR] [--] FILE...
# DIR defaults to the current directory. One finding per line, four fields separated by
# tabs (the last may be empty, its tab stays):
#   WHAT<TAB>ok|missing|warn<TAB>FILE-OR-NAME<TAB>TEXT
# check opens with these lines, from the files of DIR and HOME:
#   agent      per file in .claude/agents (FILE below it): missing without frontmatter,
#              without a name, with a briefing: key (Claude Code loads the skills of a
#              top-level skills: list, block or inline) or as a link that leads nowhere;
#              warn without a description.
#   skill      per distinct name in the agents' skills: lists: ok when the skill resolves
#              (a plain name: DIR/.claude/skills/NAME/SKILL.md or HOME/.claude/skills/...;
#              plugin:skill: HOME/.claude/plugins/cache/<market>/<plugin>/<version>/skills/
#              <skill>/SKILL.md), else missing. Claude Code skips an unknown name without
#              a word, so this line is where it shows.
#   settings   per .claude/settings.json (always) and .claude/settings.local.json (when it
#              exists): missing when it names a briefing@ plugin, else ok.
# The kit adds these lines, and no JSON is read for any of them:
#   readonly   per agent ending in -scout, -reviewer, -checker or -coordinator: warn
#              unless its disallowedTools name Edit and Write.
#   rules      missing without a *.md file in .claude/rules/.
#   board      ok with karr refs (refs/karr/*) or a BOARD.md with the headings Todo,
#              In progress, Review, Done (each the heading's whole text, outside code
#              fences; warn when one is absent); else missing.
#   claude-md  warn unless CLAUDE.md exists and names every agent (as a whole name).
#   git        missing without a repository (when a .git is there but git refuses to
#              read it, the text is the reason, git's or the kit's); warn without a remote.
#   owners     ok when DIR's OWNERS map is valid (the rules `owner` applies); missing
#              when it is invalid or unreadable; warn without an OWNERS file.
#   owner      with `owner`: ok for each requested relative file mapped by the selected
#              directory's OWNERS file; missing for an invalid or missing map, an
#              out-of-scope file or an unowned file. Exact paths win; otherwise the
#              longest literal directory prefix wins. OWNERS rows are path<TAB>owner.
#   areas      in an admin folder: only when a file AREAS is at the top of DIR, or a
#              committed rules file (a *.md in .claude/rules/, not .local.*) starts with
#              an <!-- ack: ... --> header holding shape=hub. AREAS rows are
#              folder<TAB>kind<TAB>board: the folder absolute or ~/... (read as
#              $HOME/...), the kind one lowercase word, the board file or karr; blank and
#              # lines are skipped. Per row, in file order, named as written: ok when the
#              folder exists, is the top of a git work tree, has a *.md in .claude/agents/
#              and the board its row names (BOARD.md, or refs/karr/*); missing when one
#              fails. missing for AREAS when a row is malformed or names a folder twice,
#              or shape=hub has no AREAS; warn for AREAS without a row. No card is read.
# Exit codes: 0 no line is missing, 1 a line is missing, 2
# usage error or unusable DIR.
# Errors are two lines on stderr: "ack-team: <what>" and "ack-team: <what to do>".

_help() {
  local n=0 line
  while IFS= read -r line; do
    n=$((n + 1))
    [ "$n" -ge 2 ] || continue
    case "$line" in '#'*) line="${line#\#}"; printf '%s\n' "${line# }" ;; *) break ;; esac
  done < "$_self"
}

# Git for Windows may hand over a backslash path (bash 'D:\x\ack-team').
_slashes() { case "$OSTYPE" in msys*|cygwin*) REPLY="${1//\\//}" ;; *) REPLY="$1" ;; esac; }
_slashes "${BASH_SOURCE[0]}"; _self="$REPLY"
_src="$_self"
while [ -L "$_src" ]; do
  _slashes "$(readlink "$_src")"; _t="$REPLY"
  case "$_t" in
    /*) _src="$_t" ;;
    *) case "$_src" in */*) _src="${_src%/*}/$_t" ;; *) _src="./$_t" ;; esac ;;
  esac
done
case "$_src" in */*) _dir="${_src%/*}" ;; *) _dir="." ;; esac
if ! SHARE="$(cd "$_dir/../share" 2>/dev/null && pwd)"; then
  echo "ack-team: cannot find the share directory next to bin/." >&2
  echo "ack-team: reinstall agent-construction-kit." >&2
  exit 2
fi
# shellcheck source=../share/lib.sh
. "$SHARE/lib.sh" || exit 2

TAB=$'\t'
RC=0

fail() {
  echo "ack-team: $2" >&2
  echo "ack-team: $3" >&2
  exit "$1"
}
usage_err() {
  fail 2 "$1" "usage: ack-team check [DIR] | owner [--dir DIR] [--] FILE... (see the header of $0)."
}

# emit WHAT STATUS NAME [TEXT]: one finding; tabs and line ends in TEXT become spaces.
emit() {
  local t="${4:-}"
  t="${t//$'\t'/ }"; t="${t//$'\r'/}"; t="${t//$'\n'/ }"
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$t"
  [ "$2" = missing ] && RC=1
  return 0
}

# _lower STRING -> REPLY
_lower() { REPLY="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"; }

# _unquote VALUE -> REPLY: trimmed; "x" and 'x' lose their quotes; an unquoted value
# loses a trailing " # comment"
_unquote() {
  _ack_trim "$1"
  case "$REPLY" in
    \"*) REPLY="${REPLY#\"}"; REPLY="${REPLY%%\"*}" ;;
    \'*) REPLY="${REPLY#\'}"; REPLY="${REPLY%%\'*}" ;;
    *) REPLY="${REPLY%%[ $TAB]\#*}"; _ack_trim "$REPLY" ;;
  esac
}

# _add_skills TEXT: the skill names in TEXT (one name, or a comma list, with or without
# brackets and quotes) join A_SKILLS, space separated.
_add_skills() {
  local t="$1" item
  t="${t#\[}"; t="${t%\]}"
  while [ -n "$t" ]; do
    item="${t%%,*}"
    if [ "$item" = "$t" ]; then t=""; else t="${t#*,}"; fi
    _unquote "$item"
    [ -n "$REPLY" ] && A_SKILLS="$A_SKILLS $REPLY"
  done
  return 0
}

# parse_agent FILE: sets A_FM (1 = has frontmatter), A_HASNAME, A_NAME, A_HASDESC, A_DIS
# (the disallowedTools text), A_SKILLS (the names under a top-level skills:, block or
# inline list, space separated) and A_BRIEF (1 = a top-level briefing: key). Only the
# frontmatter is read: the lines between a first line
# "---" (a UTF-8 BOM before it is fine) and the next "---".
parse_agent() {
  local f="$1" line t first=1 mode="" item val
  A_FM=0 A_HASNAME=0 A_NAME="" A_DIS="" A_HASDESC=0 A_SKILLS="" A_BRIEF=0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line//$'\r'/}"
    if [ "$first" = 1 ]; then line="${line#$'\xEF\xBB\xBF'}"; fi
    _ack_trim "$line"; t="$REPLY"
    if [ "$first" = 1 ]; then
      first=0
      [ "$t" = "---" ] || return 0
      A_FM=1
      continue
    fi
    [ "$t" = "---" ] && return 0
    case "$t" in ''|'#'*) continue ;; esac
    case "$line" in
      ' '*|"$TAB"*)
        if [ "$mode" = dis ]; then A_DIS="$A_DIS $t"
        elif [ "$mode" = skills ]; then
          case "$t" in -*) _ack_trim "${t#-}"; _add_skills "$REPLY" ;; esac
        fi ;;
      *)
        if [ "$mode" = dis ]; then
          case "$t" in -*) A_DIS="$A_DIS $t"; continue ;; esac
        elif [ "$mode" = skills ]; then
          case "$t" in -*) _ack_trim "${t#-}"; _add_skills "$REPLY"; continue ;; esac
        fi
        mode=""
        case "$t" in
          *:*) ;;
          *) continue ;;
        esac
        _ack_trim "${t%%:*}"; item="$REPLY"
        _ack_trim "${t#*:}"; val="$REPLY"
        case "$item" in
          name) A_HASNAME=1; _unquote "$val"; A_NAME="$REPLY" ;;
          description) A_HASDESC=1 ;;
          briefing) A_BRIEF=1 ;;
          disallowedTools) A_DIS="$val"; mode=dis ;;
          skills) if [ -n "$val" ]; then _add_skills "$val"; else mode=skills; fi ;;
        esac ;;
    esac
  done < "$f"
  return 0
}

# _has_word TEXT WORD: WORD stands in TEXT between non-letters
_has_word() {
  local t
  t="$(printf '%s' "$1" | tr -c 'A-Za-z' ' ')"
  case " $t " in *" $2 "*) return 0 ;; esac
  return 1
}

# _segments PATH STRICT -> REPLY: PATH's "." and ".." segments resolved, joined by "/"
# without a leading slash. A ".." with nothing left to remove fails when STRICT is 1 and
# is dropped otherwise (the way normpath treats an absolute path). Globbing is off while
# the path is split, so a "*" stays a "*".
_segments() {
  local seg out=() n=0 IFS=/ noglob=1 rc=0
  case $- in *f*) noglob=0 ;; esac
  set -f
  for seg in $1; do
    case "$seg" in
      ''|.) ;;
      ..)
        if [ "$n" -gt 0 ]; then n=$((n - 1)); unset 'out[n]'
        elif [ "$2" = 1 ]; then rc=1; break; fi ;;
      *) out[n]="$seg"; n=$((n + 1)) ;;
    esac
  done
  REPLY="${out[*]}"
  [ "$noglob" = 1 ] && set +f
  return "$rc"
}

# _collapse_path PATH -> REPLY: a relative path inside its start; fails when PATH is
# absolute or leaves the start after resolving
_collapse_path() {
  case "$1" in /*) return 1 ;; esac
  _segments "$1" 1
}

# ---------------------------------------------------------------- agents, skills, settings

# _skill_found NAME: whether Claude Code finds the skill NAME for an agent of DIR: a plain
# name as a folder with a SKILL.md in DIR/.claude/skills or HOME/.claude/skills, a name
# plugin:skill below the plugin cache, HOME/.claude/plugins/cache/<market>/<plugin>/<version>/skills/.
_skill_found() {
  local n="$1" pl sk p
  case "$n" in
    ?*:?*)
      pl="${n%%:*}"; sk="${n#*:}"
      for p in "$HOME"/.claude/plugins/cache/*/"$pl"/*/skills/"$sk"/SKILL.md; do
        [ -f "$p" ] && return 0
      done ;;
    *)
      [ -f "$DIR/.claude/skills/$n/SKILL.md" ] && return 0
      [ -f "$HOME/.claude/skills/$n/SKILL.md" ] && return 0 ;;
  esac
  return 1
}

# check_agents: one agent line per file in .claude/agents (from scan_agents): missing
# without frontmatter, without a name, with a briefing: key (Claude Code loads the skills
# of a top-level skills: list only), or as a link that leads nowhere; warn without a
# description. Then one skill line per distinct name in the skills: lists, in file order:
# ok when the skill resolves (_skill_found), else missing with the first agent naming it.
check_agents() {
  local i f seen=" " n msg
  for ((i = 0; i < ${#AF_FILES[@]}; i++)); do
    f="${AF_FILES[$i]}"
    case "${AF_STATE[$i]}" in
      dangling) emit agent missing "$f" "The link leads nowhere. Point it at an existing agent file or remove it." ;;
      nofm) emit agent missing "$f" "The file has no frontmatter. Start it with a line --- holding name, description and skills, closed by ---." ;;
      noname) emit agent missing "$f" "The frontmatter has no name. Add a name: line." ;;
      brief) emit agent missing "$f" "The frontmatter has a briefing: block. Write the list as a top-level skills: key, which Claude Code loads." ;;
      nodesc) emit agent warn "$f" "The frontmatter has no description. Add a description: line saying when to use the agent." ;;
      *) emit agent ok "$f" "" ;;
    esac
  done
  for ((i = 0; i < ${#AF_FILES[@]}; i++)); do
    for n in ${AF_SKILLS[$i]}; do
      case "$seen" in *" $n "*) continue ;; esac
      seen="$seen$n "
      if _skill_found "$n"; then emit skill ok "$n" ""
      else
        msg="${AF_FILES[$i]} names this skill, and it is in no skills folder of the project or of HOME"
        case "$n" in ?*:?*) msg="${AF_FILES[$i]} names this skill, and the plugin cache has no plugin and skill of that name" ;; esac
        emit skill missing "$n" "$msg. Install it (skilletor or claude plugin install) or correct the name; Claude Code skips an unknown skill without a word."
      fi
    done
  done
}

# check_settings: one settings line for .claude/settings.json (and for settings.local.json
# when it exists): missing when it enables a plugin briefing@..., else ok.
check_settings() {
  local rel f found=0
  for rel in .claude/settings.json .claude/settings.local.json; do
    f="$DIR/$rel"
    if [ ! -f "$f" ]; then
      [ "$rel" = .claude/settings.json ] && emit settings ok "$rel" ""
      continue
    fi
    if grep -E '"briefing@' "$f" >/dev/null 2>&1; then
      emit settings missing "$rel" "enabledPlugins names briefing@. Remove that entry: Claude Code loads the skills of an agent itself."
    else
      emit settings ok "$rel" ""
    fi
  done
}

# scan_agents: the agents every later line looks at. AG_* hold the agents with frontmatter
# for the readonly and claude-md lines: a file counts when it has frontmatter; its name is
# the file name without ".md" and without one leading ".local." (skilletor installs
# ".local.<name>.md"). AF_* hold every agent file for check_agents: path below
# .claude/agents, state (ok, dangling, nofm, noname, brief, nodesc) and skill names.
scan_agents() {
  local f rel base list st
  AG_NAMES=()      # names, in file order
  AG_DIS=()        # their disallowedTools text
  AG_FILES=()      # their paths below .claude/agents
  AF_FILES=() AF_STATE=() AF_SKILLS=()
  [ -d "$DIR/.claude/agents" ] || return 0
  list="$(find -H "$DIR/.claude/agents" \( -type f -o -type l \) -name '*.md' -print 2>/dev/null | LC_ALL=C sort)"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rel="${f#"$DIR/.claude/agents/"}"
    if [ ! -f "$f" ]; then
      AF_FILES[${#AF_FILES[@]}]="$rel"; AF_STATE[${#AF_STATE[@]}]=dangling; AF_SKILLS[${#AF_SKILLS[@]}]=""
      continue
    fi
    base="${rel##*/}"; base="${base%.md}"
    case "$base" in .local.?*) base="${base#.local.}" ;; esac
    parse_agent "$f"
    st=ok
    if [ "$A_FM" != 1 ]; then st=nofm
    elif [ "$A_HASNAME" != 1 ] || [ -z "$A_NAME" ]; then st=noname
    elif [ "$A_BRIEF" = 1 ]; then st=brief
    elif [ "$A_HASDESC" != 1 ]; then st=nodesc; fi
    AF_FILES[${#AF_FILES[@]}]="$rel"; AF_STATE[${#AF_STATE[@]}]="$st"; AF_SKILLS[${#AF_SKILLS[@]}]="$A_SKILLS"
    [ "$A_FM" = 1 ] || continue
    AG_NAMES[${#AG_NAMES[@]}]="$base"
    AG_FILES[${#AG_FILES[@]}]="$rel"
    AG_DIS[${#AG_DIS[@]}]="$A_DIS"
  done <<EOT
$list
EOT
}

_role_match() { # NAME ROLE
  case "$1" in
    *-"$2") return 0 ;;
  esac
  return 1
}

check_readonly() {
  local i name role ro
  for ((i = 0; i < ${#AG_NAMES[@]}; i++)); do
    name="${AG_NAMES[$i]}"
    ro=0
    for role in scout reviewer checker coordinator; do
      _role_match "$name" "$role" && ro=1
    done
    [ "$ro" = 1 ] || continue
    if _has_word "${AG_DIS[$i]}" Edit && _has_word "${AG_DIS[$i]}" Write; then
      emit readonly ok "${AG_FILES[$i]}" ""
    else
      emit readonly warn "${AG_FILES[$i]}" "read-only role without disallowedTools naming Edit and Write"
    fi
  done
}

check_rules() {
  local hit=""
  if [ -d "$DIR/.claude/rules" ]; then
    hit="$(find "$DIR/.claude/rules" -type f -name '*.md' -print 2>/dev/null | head -n 1)"
  fi
  if [ -n "$hit" ]; then
    emit rules ok ".claude/rules" ""
  else
    emit rules missing ".claude/rules" "no rule files"
  fi
}

# ---------------------------------------------------------------- board, claude-md, git

check_board() {
  local line t marks todo=0 prog=0 rev=0 done_=0 fence=0 miss="" have_karr=""
  if [ -n "$GITTOP" ]; then
    have_karr="$(git -C "$DIR" for-each-ref --count=1 refs/karr 2>/dev/null)"
  fi
  if [ -n "$have_karr" ]; then
    emit board ok karr ""
    return 0
  fi
  if [ ! -f "$DIR/BOARD.md" ]; then
    emit board missing "BOARD.md" "no karr refs and no BOARD.md"
    return 0
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line//$'\r'/}"
    _ack_trim "$line"; t="$REPLY"
    case "$t" in
      '```'*|'~~~'*) [ "$fence" = 1 ] && fence=0 || fence=1; continue ;;
    esac
    [ "$fence" = 0 ] || continue
    # a heading: up to three spaces, 1-6 hashes, then a space (or the line ends)
    t="$line"
    case "$t" in "    "*|"$TAB"*) continue ;; esac
    t="${t#"${t%%[! ]*}"}"
    marks="${t%%[!#]*}"
    case "${#marks}" in 1|2|3|4|5|6) ;; *) continue ;; esac
    t="${t#"$marks"}"
    case "$t" in ''|' '*|"$TAB"*) ;; *) continue ;; esac
    t="$(printf '%s' "$t" | tr -d '*`')"
    _ack_trim "$t"; t="$REPLY"
    t="${t%"${t##*[!#]}"}"
    _ack_trim "$t"; t="$REPLY"
    t="${t#"${t%%[!_]*}"}"; t="${t%"${t##*[!_]}"}"
    _lower "$t"
    case "$REPLY" in
      todo) todo=1 ;;
      "in progress") prog=1 ;;
      review) rev=1 ;;
      done) done_=1 ;;
    esac
  done < "$DIR/BOARD.md"
  [ "$todo" = 1 ] || miss="$miss, Todo"
  [ "$prog" = 1 ] || miss="$miss, In progress"
  [ "$rev" = 1 ] || miss="$miss, Review"
  [ "$done_" = 1 ] || miss="$miss, Done"
  if [ -z "$miss" ]; then
    emit board ok "BOARD.md" ""
  else
    emit board warn "BOARD.md" "no heading for: ${miss#, }"
  fi
}

check_claude_md() {
  local n rx bad=0
  if [ ! -f "$DIR/CLAUDE.md" ]; then
    emit claude-md warn "CLAUDE.md" "not found"
    return 0
  fi
  for n in "${AG_NAMES[@]}"; do
    # the name stands between characters that are no part of a name, or at a line end
    rx="$(printf '%s' "$n" | sed 's/[][\.*^$+?(){}|/]/\\&/g')"
    if ! grep -E -- "(^|[^A-Za-z0-9_-])$rx([^A-Za-z0-9_-]|\$)" "$DIR/CLAUDE.md" >/dev/null 2>&1; then
      emit claude-md warn "CLAUDE.md" "does not name the agent $n"
      bad=1
    fi
  done
  [ "$bad" = 1 ] || emit claude-md ok "CLAUDE.md" ""
}

check_git() {
  if [ -z "$GITTOP" ]; then
    if command -v git >/dev/null 2>&1 && ack_git_refused "$DIR"; then
      emit git missing "." "git cannot read the repository: $REPLY"
    else
      emit git missing "." "not a git repository"
    fi
  elif [ -z "$(git -C "$DIR" remote 2>/dev/null)" ]; then
    emit git warn "." "no remote: the history exists only on this machine"
  else
    emit git ok "." ""
  fi
}

# ---------------------------------------------------------------- ownership

# _owner_agents -> OWNER_AGENTS: declared agent names below the selected directory. This
# deliberately reads only frontmatter.
_owner_agents() {
  local f list
  OWNER_AGENTS=()
  [ -d "$DIR/.claude/agents" ] || return 0
  list="$(find -H "$DIR/.claude/agents" \( -type f -o -type l \) -name '*.md' -print 2>/dev/null | LC_ALL=C sort)"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    parse_agent "$f"
    [ "$A_FM" = 1 ] && [ "$A_HASNAME" = 1 ] && [ -n "$A_NAME" ] || continue
    OWNER_AGENTS[${#OWNER_AGENTS[@]}]="$A_NAME"
  done <<EOT
$list
EOT
}

# _owner_known NAME: main or one of the selected directory's declared agents.
_owner_known() {
  local name
  [ "$1" = main ] && return 0
  for name in "${OWNER_AGENTS[@]}"; do
    [ "$1" = "$name" ] && return 0
  done
  return 1
}

# _owner_rule_path PATH -> OWNER_RULE_PATH and OWNER_RULE_DIRECTORY. Rules are relative
# forward-slash paths; a trailing slash describes a directory prefix.
_owner_rule_path() {
  local path="$1"
  OWNER_RULE_PATH="" OWNER_RULE_DIRECTORY=0
  case "$path" in
    ''|*"$TAB"*|*$'\n'*|*$'\r'*|/*|[A-Za-z]:*) return 1 ;;
  esac
  case "$path" in
    */) OWNER_RULE_DIRECTORY=1; path="${path%/}" ;;
  esac
  case "$path" in ''|*\\*) return 1 ;; esac
  _collapse_path "$path" || return 1
  [ -n "$REPLY" ] || return 1
  case "$REPLY" in [A-Za-z]:*) return 1 ;; esac
  OWNER_RULE_PATH="$REPLY"
  return 0
}

# _owner_input_path PATH -> OWNER_INPUT_PATH. On Git for Windows and Cygwin a relative
# backslash path follows the same spelling conversion as the command's own path.
_owner_input_path() {
  local path="$1"
  OWNER_INPUT_PATH=""
  case "$path" in *"$TAB"*|*$'\n'*|*$'\r'*) return 1 ;; esac
  _slashes "$path"; path="$REPLY"
  case "$path" in ''|/*|[A-Za-z]:*) return 1 ;; esac
  _collapse_path "$path" || return 1
  [ -n "$REPLY" ] || return 1
  case "$REPLY" in [A-Za-z]:*) return 1 ;; esac
  OWNER_INPUT_PATH="$REPLY"
  return 0
}

# _owner_map_error TEXT -> OWNER_MAP_ERROR: why the selected directory's map is invalid,
# for the caller to report once (owner before any lookup, check as its owners line).
_owner_map_error() {
  OWNER_MAP_ERROR="$1"
  return 1
}

# _owner_read_map -> OWNER_RULE_PATHS, OWNER_RULE_DIRECTORIES, OWNER_RULE_OWNERS, or
# OWNER_MAP_ERROR. A map is validated completely before any requested file is resolved.
_owner_read_map() {
  local map="$DIR/OWNERS" line trimmed path owner i
  OWNER_RULE_PATHS=() OWNER_RULE_DIRECTORIES=() OWNER_RULE_OWNERS=() OWNER_MAP_ERROR=""
  if [ ! -f "$map" ] || [ ! -r "$map" ]; then
    _owner_map_error "is missing or unreadable"
    return 1
  fi
  _owner_agents
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    _ack_trim "$line"; trimmed="$REPLY"
    case "$trimmed" in ''|'#'*) continue ;; esac
    case "$line" in
      *"$TAB"*) path="${line%%"$TAB"*}"; owner="${line#*"$TAB"}" ;;
      *) _owner_map_error "has a malformed row"; return 1 ;;
    esac
    case "$owner" in ''|*"$TAB"*|*$'\n'*|*$'\r'*)
      _owner_map_error "has a malformed row"; return 1 ;;
    esac
    if ! _owner_rule_path "$path"; then
      _owner_map_error "has a path outside the selected directory or not using forward slashes"
      return 1
    fi
    if ! _owner_known "$owner"; then
      _owner_map_error "names an owner that is neither main nor a declared agent"
      return 1
    fi
    for ((i = 0; i < ${#OWNER_RULE_PATHS[@]}; i++)); do
      if [ "${OWNER_RULE_PATHS[$i]}" = "$OWNER_RULE_PATH" ] &&
         [ "${OWNER_RULE_DIRECTORIES[$i]}" = "$OWNER_RULE_DIRECTORY" ]; then
        _owner_map_error "has a duplicate normalized path"
        return 1
      fi
    done
    OWNER_RULE_PATHS[${#OWNER_RULE_PATHS[@]}]="$OWNER_RULE_PATH"
    OWNER_RULE_DIRECTORIES[${#OWNER_RULE_DIRECTORIES[@]}]="$OWNER_RULE_DIRECTORY"
    OWNER_RULE_OWNERS[${#OWNER_RULE_OWNERS[@]}]="$owner"
  done < "$map"
  return 0
}

# _owner_for PATH -> REPLY: exact rules win; otherwise the longest directory prefix wins.
_owner_for() {
  local path="$1" i rule found="" length longest=-1
  for ((i = 0; i < ${#OWNER_RULE_PATHS[@]}; i++)); do
    [ "${OWNER_RULE_DIRECTORIES[$i]}" = 0 ] || continue
    [ "${OWNER_RULE_PATHS[$i]}" = "$path" ] || continue
    REPLY="${OWNER_RULE_OWNERS[$i]}"
    return 0
  done
  for ((i = 0; i < ${#OWNER_RULE_PATHS[@]}; i++)); do
    [ "${OWNER_RULE_DIRECTORIES[$i]}" = 1 ] || continue
    rule="${OWNER_RULE_PATHS[$i]}"
    length=${#rule}
    [ "${#path}" -gt "$length" ] || continue
    [ "${path:0:$length}" = "$rule" ] || continue
    [ "${path:$length:1}" = / ] || continue
    if [ "$length" -gt "$longest" ]; then
      found="${OWNER_RULE_OWNERS[$i]}"
      longest="$length"
    fi
  done
  [ -n "$found" ] || return 1
  REPLY="$found"
  return 0
}

# check_owners: the owners line of check. No OWNERS file is a warning, since teams made
# before the map existed have none; a map that `owner` would refuse is missing.
check_owners() {
  if [ ! -e "$DIR/OWNERS" ] && [ ! -L "$DIR/OWNERS" ]; then
    emit owners warn OWNERS "no OWNERS map: no path has a recorded write owner"
  elif _owner_read_map; then
    emit owners ok OWNERS ""
  else
    emit owners missing OWNERS "The OWNERS map $OWNER_MAP_ERROR. Correct the map and run ack-team check again."
  fi
}

cmd_owner() {
  local directory="." directory_set=0 file shown
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir)
        [ "$directory_set" = 0 ] || usage_err "owner takes --dir only once."
        [ $# -ge 2 ] || usage_err "--dir needs a directory."
        directory="$2"; directory_set=1; shift 2 ;;
      --) shift; break ;;
      -h|--help) _help; exit 0 ;;
      -*) usage_err "unknown option '$1'." ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || usage_err "owner needs at least one file."
  DIR="$(CDPATH= cd -- "$directory" 2>/dev/null && pwd)" && [ -n "$DIR" ] ||
    fail 2 "'$directory' is not a directory." "pass the directory that contains OWNERS."
  DIR="${DIR%/}"
  if ! _owner_read_map; then
    emit owner missing OWNERS "The OWNERS map $OWNER_MAP_ERROR. Correct the map and run ack-team owner again."
    exit "$RC"
  fi
  for file in "$@"; do
    if ! _owner_input_path "$file"; then
      shown="${file//$TAB/ }"; shown="${shown//$'\r'/ }"; shown="${shown//$'\n'/ }"
      emit owner missing "$shown" "The requested path is outside the selected directory or contains a tab or newline. Use a relative file path below the selected directory."
      continue
    fi
    if _owner_for "$OWNER_INPUT_PATH"; then
      emit owner ok "$OWNER_INPUT_PATH" "$REPLY"
    else
      emit owner missing "$OWNER_INPUT_PATH" "No owner is mapped for this path. Add an exact or directory rule to OWNERS."
    fi
  done
  exit "$RC"
}

# ---------------------------------------------------------------- areas

# _areas_hub: a committed rules file (a *.md below .claude/rules/ in HEAD, not .local.*)
# starts with an <!-- ack: ... --> header that holds shape=hub. Only its first line is read.
_areas_hub() {
  local f line inner
  [ -n "$GITTOP" ] || return 1
  while IFS= read -r f; do
    case "$f" in *.md) ;; *) continue ;; esac
    case "${f##*/}" in .local.*) continue ;; esac
    [ -f "$DIR/$f" ] || continue
    line=""
    IFS= read -r line < "$DIR/$f" || [ -n "$line" ] || continue
    line="${line%$'\r'}"; line="${line#$'\xEF\xBB\xBF'}"
    _ack_trim "$line"; line="$REPLY"
    case "$line" in '<!-- ack:'*'-->') ;; *) continue ;; esac
    inner="${line#'<!-- ack:'}"; inner="${inner%'-->'}"
    case " $inner " in *[" $TAB"]shape=hub[" $TAB"]*) return 0 ;; esac
  done <<EOT
$(git -C "$DIR" -c core.quotePath=false ls-tree -r --name-only HEAD -- .claude/rules 2>/dev/null)
EOT
  return 1
}

# _areas_read TABLE -> AREA_SHOWN (each folder as written), AREA_PATHS, AREA_BOARDS, in
# file order; read as _owner_read_map reads OWNERS (blank and # lines skipped, a CR at the
# line end dropped). Returns 1 after the one line for a malformed table.
_areas_read() {
  local line n=0 f rest kind board path i
  AREA_SHOWN=() AREA_PATHS=() AREA_BOARDS=()
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line="${line%$'\r'}"
    _ack_trim "$line"
    case "$REPLY" in ''|'#'*) continue ;; esac
    case "$line" in
      *"$TAB"*"$TAB"*"$TAB"*) _areas_bad "Line $n of AREAS has more than three fields."; return 1 ;;
      *"$TAB"*"$TAB"*) ;;
      *) _areas_bad "Line $n of AREAS has fewer than three fields."; return 1 ;;
    esac
    f="${line%%"$TAB"*}"; rest="${line#*"$TAB"}"
    _ack_trim "${rest%%"$TAB"*}"; kind="$REPLY"
    _ack_trim "${rest#*"$TAB"}"; board="$REPLY"
    _slashes "$f"; path="$REPLY"
    case "$path" in
      '~/'?*) path="$HOME/${path#'~/'}" ;;
      /?*|[A-Za-z]:/?*) ;;
      *) _areas_bad "Line $n of AREAS names a folder that is neither absolute nor below ~/."
         return 1 ;;
    esac
    path="${path%/}"
    case "$kind" in
      ''|[!abcdefghijklmnopqrstuvwxyz]*|*[!abcdefghijklmnopqrstuvwxyz-]*)
        _areas_bad "Line $n of AREAS has a kind that is not one lowercase word."; return 1 ;;
    esac
    case "$board" in
      file|karr) ;;
      *) _areas_bad "Line $n of AREAS names the board '$board', which is neither file nor karr."
         return 1 ;;
    esac
    for ((i = 0; i < ${#AREA_PATHS[@]}; i++)); do
      if [ "${AREA_PATHS[$i]}" = "$path" ]; then
        _areas_bad "Line $n of AREAS names a folder that an earlier row names already."
        return 1
      fi
    done
    AREA_SHOWN[${#AREA_SHOWN[@]}]="$f"
    AREA_PATHS[${#AREA_PATHS[@]}]="$path"
    AREA_BOARDS[${#AREA_BOARDS[@]}]="$board"
  done < "$1"
  return 0
}

# _areas_bad TEXT: the one line for a malformed AREAS table
_areas_bad() {
  emit areas missing AREAS "$1 Rows are folder<TAB>kind<TAB>board; correct the table and run ack-team check again."
}

# _area_row SHOWN PATH BOARD: the line of one area
_area_row() {
  local s="$1" p="$2" top f hit=""
  local fix="Build the area's team there, or correct its row in AREAS."
  if [ ! -d "$p" ]; then
    emit areas missing "$s" "The folder does not exist. $fix"
    return 0
  fi
  top="$(git -C "$p" rev-parse --show-toplevel 2>/dev/null)"
  if [ -z "$top" ]; then
    emit areas missing "$s" "The folder is no git repository. $fix"
    return 0
  fi
  if ! ack_same_dir "$top" "$p"; then
    emit areas missing "$s" "The folder lies inside another repository instead of being the top of its own. Give the area a repository of its own, or correct its row in AREAS."
    return 0
  fi
  for f in "$p"/.claude/agents/*.md; do
    if [ -e "$f" ]; then hit=1; break; fi
  done
  if [ -z "$hit" ]; then
    emit areas missing "$s" "The folder has no agent file (*.md) in .claude/agents/. $fix"
    return 0
  fi
  case "$3" in
    file)
      if [ ! -f "$p/BOARD.md" ]; then
        emit areas missing "$s" "The row names the board file, but the folder has no BOARD.md. Start the area's board there, or correct the board word in AREAS."
        return 0
      fi ;;
    karr)
      if [ -z "$(git -C "$p" for-each-ref --count=1 refs/karr 2>/dev/null)" ]; then
        emit areas missing "$s" "The row names the board karr, but the folder has no karr refs (refs/karr/*). Start the area's board there, or correct the board word in AREAS."
        return 0
      fi ;;
  esac
  emit areas ok "$s" ""
}

# check_areas: the areas lines of an admin folder, only when AREAS is at the top of DIR
# or the committed rules say shape=hub. No card is read.
check_areas() {
  local table="${GITTOP:-$DIR}/AREAS" i
  if [ ! -e "$table" ] && [ ! -L "$table" ]; then
    _areas_hub || return 0
    emit areas missing AREAS "The rules say shape=hub, but there is no AREAS file at the top of this folder. Write AREAS with one row per area (folder, kind and board, separated by tabs), or correct the shape in the rules."
    return 0
  fi
  if [ ! -f "$table" ] || [ ! -r "$table" ]; then
    emit areas missing AREAS "AREAS is no readable file. Make it a file with one row per area and run ack-team check again."
    return 0
  fi
  _areas_read "$table" || return 0
  if [ "${#AREA_PATHS[@]}" -eq 0 ]; then
    emit areas warn AREAS "AREAS has no row yet. Add one row per area: its folder, kind and board, separated by tabs."
    return 0
  fi
  for ((i = 0; i < ${#AREA_PATHS[@]}; i++)); do
    _area_row "${AREA_SHOWN[$i]}" "${AREA_PATHS[$i]}" "${AREA_BOARDS[$i]}"
  done
}

cmd_check() {
  [ $# -le 1 ] || usage_err "check takes at most one directory."
  case "${1:-}" in -*) usage_err "unknown option '$1'." ;; esac
  DIR="$(CDPATH= cd -- "${1:-.}" 2>/dev/null && pwd)" && [ -n "$DIR" ] ||
    fail 2 "'${1:-.}' is not a directory." "pass the repository that holds the team."
  DIR="${DIR%/}"
  GITTOP=""
  if command -v git >/dev/null 2>&1; then
    GITTOP="$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null)"
  fi
  scan_agents
  check_agents
  check_settings
  check_readonly
  check_rules
  check_board
  check_claude_md
  check_git
  check_owners
  check_areas
  exit "$RC"
}

main() {
  [ $# -gt 0 ] || usage_err "missing subcommand."
  local sub="$1"
  shift
  case "$sub" in
    check) cmd_check "$@" ;;
    owner) cmd_owner "$@" ;;
    -h|--help|help) _help; exit 0 ;;
    *) usage_err "unknown subcommand '$sub'." ;;
  esac
}
# run unless sourced (the tests source the file to try single functions)
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
