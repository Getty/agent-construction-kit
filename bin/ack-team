#!/usr/bin/env bash
# ack-team: check a finished agent team or resolve repository file ownership. It changes
# no file in DIR; check's call of briefing keeps its output in a temporary directory that
# it removes.
#   ack-team check [DIR]
#   ack-team owner [--dir DIR] [--] FILE...
# DIR defaults to the current directory. One finding per line, four fields separated by
# tabs (the last may be empty, its tab stays):
#   WHAT<TAB>ok|missing|warn<TAB>FILE-OR-NAME<TAB>TEXT
# The agent, skill, hook and settings findings come from the briefing plugin: check runs
# `briefing doctor --tsv` in DIR for at most ACK_BRIEFING_WAIT seconds (default 30), with
# no --cwd: a path with characters outside the Windows ANSI code page does not survive a
# Perl command line, the working directory does. Its lines pass on unchanged, every CR
# dropped, but only lines of the contract: four
# tab-separated fields, WHAT one of agent, skill, hook, settings, status ok, missing or
# warn. See briefing for what each one checks. When no briefing command answers (not on
# PATH, no answer in time, exit 2 or more, or no settings line among the contract
# lines), check prints one line, "briefing<TAB>missing<TAB>.<TAB>TEXT", and goes on with
# its own; TEXT names the command's path when there is one.
# The kit adds these lines, and no JSON is read for any of them:
#   readonly   per agent ending in -scout, -reviewer, -checker or -coordinator: warn
#              unless its disallowedTools name Edit and Write.
#   rules      missing without a *.md file in .claude/rules/.
#   board      ok with karr refs (refs/karr/*) or a BOARD.md with the headings Todo,
#              In progress, Review, Done (each the heading's whole text, outside code
#              fences; warn when one is absent); else missing.
#   claude-md  warn unless CLAUDE.md exists and names every agent (as a whole name).
#   git        missing without a repository (when a .git is there but git refuses to
#              read it, the text is the reason, git's or the kit's); warn without a remote.
#   owners     ok when DIR's OWNERS map is valid (the rules `owner` applies); missing
#              when it is invalid or unreadable; warn without an OWNERS file.
#   owner      with `owner`: ok for each requested relative file mapped by the selected
#              directory's OWNERS file; missing for an invalid or missing map, an
#              out-of-scope file or an unowned file. Exact paths win; otherwise the
#              longest literal directory prefix wins. OWNERS rows are path<TAB>owner.
# Exit codes: 0 no line is missing (briefing's lines included), 1 a line is missing, 2
# usage error or unusable DIR.
# Errors are two lines on stderr: "ack-team: <what>" and "ack-team: <what to do>".

_help() {
  local n=0 line
  while IFS= read -r line; do
    n=$((n + 1))
    [ "$n" -ge 2 ] || continue
    case "$line" in '#'*) line="${line#\#}"; printf '%s\n' "${line# }" ;; *) break ;; esac
  done < "$_self"
}

# Git for Windows may hand over a backslash path (bash 'D:\x\ack-team').
_slashes() { case "$OSTYPE" in msys*|cygwin*) REPLY="${1//\\//}" ;; *) REPLY="$1" ;; esac; }
_slashes "${BASH_SOURCE[0]}"; _self="$REPLY"
_src="$_self"
while [ -L "$_src" ]; do
  _slashes "$(readlink "$_src")"; _t="$REPLY"
  case "$_t" in
    /*) _src="$_t" ;;
    *) case "$_src" in */*) _src="${_src%/*}/$_t" ;; *) _src="./$_t" ;; esac ;;
  esac
done
case "$_src" in */*) _dir="${_src%/*}" ;; *) _dir="." ;; esac
if ! SHARE="$(cd "$_dir/../share" 2>/dev/null && pwd)"; then
  echo "ack-team: cannot find the share directory next to bin/." >&2
  echo "ack-team: reinstall agent-construction-kit." >&2
  exit 2
fi
# shellcheck source=../share/lib.sh
. "$SHARE/lib.sh" || exit 2

TAB=$'\t'
RC=0

fail() {
  echo "ack-team: $2" >&2
  echo "ack-team: $3" >&2
  exit "$1"
}
usage_err() {
  fail 2 "$1" "usage: ack-team check [DIR] | owner [--dir DIR] [--] FILE... (see the header of $0)."
}

# emit WHAT STATUS NAME [TEXT]: one finding; tabs and line ends in TEXT become spaces.
emit() {
  local t="${4:-}"
  t="${t//$'\t'/ }"; t="${t//$'\r'/}"; t="${t//$'\n'/ }"
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$t"
  [ "$2" = missing ] && RC=1
  return 0
}

# _lower STRING -> REPLY
_lower() { REPLY="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"; }

# _unquote VALUE -> REPLY: trimmed; "x" and 'x' lose their quotes; an unquoted value
# loses a trailing " # comment"
_unquote() {
  _ack_trim "$1"
  case "$REPLY" in
    \"*) REPLY="${REPLY#\"}"; REPLY="${REPLY%%\"*}" ;;
    \'*) REPLY="${REPLY#\'}"; REPLY="${REPLY%%\'*}" ;;
    *) REPLY="${REPLY%%[ $TAB]\#*}"; _ack_trim "$REPLY" ;;
  esac
}

# parse_agent FILE: sets A_FM (1 = has frontmatter), A_HASNAME, A_NAME and A_DIS (the
# disallowedTools text). Only the frontmatter is read: the lines between a first line
# "---" (a UTF-8 BOM before it is fine) and the next "---".
parse_agent() {
  local f="$1" line t first=1 mode="" item val
  A_FM=0 A_HASNAME=0 A_NAME="" A_DIS=""
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line//$'\r'/}"
    if [ "$first" = 1 ]; then line="${line#$'\xEF\xBB\xBF'}"; fi
    _ack_trim "$line"; t="$REPLY"
    if [ "$first" = 1 ]; then
      first=0
      [ "$t" = "---" ] || return 0
      A_FM=1
      continue
    fi
    [ "$t" = "---" ] && return 0
    case "$t" in ''|'#'*) continue ;; esac
    case "$line" in
      ' '*|"$TAB"*)
        [ "$mode" = dis ] && A_DIS="$A_DIS $t" ;;
      *)
        if [ "$mode" = dis ]; then
          case "$t" in -*) A_DIS="$A_DIS $t"; continue ;; esac
        fi
        mode=""
        case "$t" in
          *:*) ;;
          *) continue ;;
        esac
        _ack_trim "${t%%:*}"; item="$REPLY"
        _ack_trim "${t#*:}"; val="$REPLY"
        case "$item" in
          name) A_HASNAME=1; _unquote "$val"; A_NAME="$REPLY" ;;
          disallowedTools) A_DIS="$val"; mode=dis ;;
        esac ;;
    esac
  done < "$f"
  return 0
}

# _has_word TEXT WORD: WORD stands in TEXT between non-letters
_has_word() {
  local t
  t="$(printf '%s' "$1" | tr -c 'A-Za-z' ' ')"
  case " $t " in *" $2 "*) return 0 ;; esac
  return 1
}

# _segments PATH STRICT -> REPLY: PATH's "." and ".." segments resolved, joined by "/"
# without a leading slash. A ".." with nothing left to remove fails when STRICT is 1 and
# is dropped otherwise (the way normpath treats an absolute path). Globbing is off while
# the path is split, so a "*" stays a "*".
_segments() {
  local seg out=() n=0 IFS=/ noglob=1 rc=0
  case $- in *f*) noglob=0 ;; esac
  set -f
  for seg in $1; do
    case "$seg" in
      ''|.) ;;
      ..)
        if [ "$n" -gt 0 ]; then n=$((n - 1)); unset 'out[n]'
        elif [ "$2" = 1 ]; then rc=1; break; fi ;;
      *) out[n]="$seg"; n=$((n + 1)) ;;
    esac
  done
  REPLY="${out[*]}"
  [ "$noglob" = 1 ] && set +f
  return "$rc"
}

# _missing_program TEXT -> REPLY: the program a first stderr line says is missing, from
# "X is required but was not found ..." or "...: X: command not found"; fails otherwise.
# ack-doctor has the same function.
_missing_program() {
  local t="$1"
  case "$t" in
    *" is required but was not found"*) t="${t%%" is required but was not found"*}" ;;
    *": command not found"*) t="${t%%": command not found"*}" ;;
    *) return 1 ;;
  esac
  _ack_trim "${t##*": "}"
  [ -n "$REPLY" ]
}

# _collapse_path PATH -> REPLY: a relative path inside its start; fails when PATH is
# absolute or leaves the start after resolving
_collapse_path() {
  case "$1" in /*) return 1 ;; esac
  _segments "$1" 1
}

# ---------------------------------------------------------------- briefing

# _briefing_doctor BIN: `BIN doctor --tsv` run from DIR. Meant to run inside
# ack_run_bounded, which starts it as a background subshell: the cd stays out of the
# caller, and exec makes BIN that process, so a timeout or a signal kills briefing itself
# and not just a subshell around it. A cd that fails is an exit 2 with the reason on
# stderr, which check_briefing reports like any failed run.
_briefing_doctor() {
  CDPATH= cd -- "$DIR" 2>/dev/null || {
    echo "ack-team: cannot enter $DIR to run briefing." >&2
    return 2
  }
  exec "$1" doctor --tsv
}

# check_briefing: the agent, skill, hook and settings lines are the briefing plugin's.
# Only lines of the contract pass through: four fields split at the tabs (the last may be
# empty), WHAT one of agent, skill, hook, settings, status ok, missing or warn, a name
# that is not empty. A valid run always has a settings line. briefing's exit 1 only says
# some lines are missing, so the passed lines decide RC. The call is cut off after
# ACK_BRIEFING_WAIT seconds (1 to 5 digits, no leading zero; default 30). Anything else is
# one missing line: no command on PATH, no answer in time, exit 2 or more, or no settings
# line among the contract lines; the text names the command's path and, when the command
# failed, its exit status and first stderr line. The advice is to install the program
# that line names as missing (perl, Node.js), or, when briefing's starter says that perl
# was not found or does not load App::Briefing, to install perl or the Perl modules
# briefing needs (cpanm --installdeps with the plugin folder, the starter's bin/.., which
# holds briefing's cpanfile), else to update or install the plugin.
check_briefing() {
  local bin rc line r what st name text valid="" wait="${ACK_BRIEFING_WAIT:-30}" settings=0 why pd
  local tail="so the agent, skill, hook and settings checks cannot run"
  local fix="Update or install the briefing plugin with: claude plugin update briefing@getty (or install it with: claude plugin install briefing@getty), then run /reload-plugins."
  case "$wait" in
    [1-9]|[1-9][0-9]|[1-9][0-9][0-9]|[1-9][0-9][0-9][0-9]|[1-9][0-9][0-9][0-9][0-9]) ;;
    *) wait=30 ;;
  esac
  if ! bin="$(type -P briefing 2>/dev/null)" || [ -z "$bin" ]; then
    emit briefing missing "." "No briefing command was found on PATH, $tail. $fix"
    return 0
  fi
  ack_run_bounded "$wait" _briefing_doctor "$bin"; rc=$?
  why=""
  if [ "$rc" != 0 ] && [ "$rc" != 124 ]; then
    why=" (exit $rc"
    [ -n "$ACK_BOUNDED_ERR" ] && why="$why: $ACK_BOUNDED_ERR"
    why="$why)"
    # a program briefing needs is missing: installing it helps, updating the plugin not;
    # the same for briefing's starter: "... no fallback (...perl was not found on PATH)." or
    # "...this perl does not load App::Briefing (...)."
    if _missing_program "$ACK_BOUNDED_ERR"; then fix="Install $REPLY and run this again."
    else
      case "$ACK_BOUNDED_ERR" in
        *"perl was not found on PATH"*) fix="Install perl and run this again." ;;
        *"this perl does not load App::Briefing"*)
          pd="$(CDPATH= cd -P -- "${bin%/*}/.." 2>/dev/null && pwd)" || pd="${bin%/*}/.."
          fix="Install the Perl modules briefing needs with: cpanm --installdeps \"$pd\", then run this again." ;;
      esac
    fi
  fi
  if [ "$rc" = 124 ]; then
    emit briefing missing "." "The briefing command at $bin did not answer within $wait seconds, $tail. $fix"
    return 0
  elif [ "$rc" -gt 1 ]; then
    emit briefing missing "." "The briefing command at $bin did not run the check$why, $tail. $fix"
    return 0
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line//$'\r'/}"
    what="${line%%"$TAB"*}"
    [ "$what" != "$line" ] || continue
    r="${line#*"$TAB"}"
    st="${r%%"$TAB"*}"
    [ "$st" != "$r" ] || continue
    r="${r#*"$TAB"}"
    name="${r%%"$TAB"*}"
    [ "$name" != "$r" ] || continue
    text="${r#*"$TAB"}"
    case "$text" in *"$TAB"*) continue ;; esac
    [ -n "$name" ] || continue
    case "$what" in agent|skill|hook|settings) ;; *) continue ;; esac
    case "$st" in ok|missing|warn) ;; *) continue ;; esac
    [ "$what" = settings ] && settings=1
    [ "$st" = missing ] && RC=1
    valid="$valid$line"$'\n'
  done <<EOT
$ACK_BOUNDED_OUT
EOT
  if [ "$settings" = 0 ]; then
    # the lines that were counted belong to a run that is not used
    RC=0
    emit briefing missing "." "The briefing command at $bin printed no check lines in the expected format$why, $tail. $fix"
    return 0
  fi
  printf '%s' "$valid"
  return 0
}

# scan_agents: the agents the readonly and claude-md lines look at, quietly (briefing
# reports the broken ones). A file counts when it has frontmatter; its name is the file
# name without ".md" and without one leading ".local." (skilletor installs
# ".local.<name>.md").
scan_agents() {
  local f rel base list
  AG_NAMES=()      # names, in file order
  AG_DIS=()        # their disallowedTools text
  AG_FILES=()      # their paths below .claude/agents
  [ -d "$DIR/.claude/agents" ] || return 0
  list="$(find -H "$DIR/.claude/agents" \( -type f -o -type l \) -name '*.md' -print 2>/dev/null | LC_ALL=C sort)"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    rel="${f#"$DIR/.claude/agents/"}"
    base="${rel##*/}"; base="${base%.md}"
    case "$base" in .local.?*) base="${base#.local.}" ;; esac
    parse_agent "$f"
    [ "$A_FM" = 1 ] || continue
    AG_NAMES[${#AG_NAMES[@]}]="$base"
    AG_FILES[${#AG_FILES[@]}]="$rel"
    AG_DIS[${#AG_DIS[@]}]="$A_DIS"
  done <<EOT
$list
EOT
}

_role_match() { # NAME ROLE
  case "$1" in
    *-"$2") return 0 ;;
  esac
  return 1
}

check_readonly() {
  local i name role ro
  for ((i = 0; i < ${#AG_NAMES[@]}; i++)); do
    name="${AG_NAMES[$i]}"
    ro=0
    for role in scout reviewer checker coordinator; do
      _role_match "$name" "$role" && ro=1
    done
    [ "$ro" = 1 ] || continue
    if _has_word "${AG_DIS[$i]}" Edit && _has_word "${AG_DIS[$i]}" Write; then
      emit readonly ok "${AG_FILES[$i]}" ""
    else
      emit readonly warn "${AG_FILES[$i]}" "read-only role without disallowedTools naming Edit and Write"
    fi
  done
}

check_rules() {
  local hit=""
  if [ -d "$DIR/.claude/rules" ]; then
    hit="$(find "$DIR/.claude/rules" -type f -name '*.md' -print 2>/dev/null | head -n 1)"
  fi
  if [ -n "$hit" ]; then
    emit rules ok ".claude/rules" ""
  else
    emit rules missing ".claude/rules" "no rule files"
  fi
}

# ---------------------------------------------------------------- board, claude-md, git

check_board() {
  local line t marks todo=0 prog=0 rev=0 done_=0 fence=0 miss="" have_karr=""
  if [ -n "$GITTOP" ]; then
    have_karr="$(git -C "$DIR" for-each-ref --count=1 refs/karr 2>/dev/null)"
  fi
  if [ -n "$have_karr" ]; then
    emit board ok karr ""
    return 0
  fi
  if [ ! -f "$DIR/BOARD.md" ]; then
    emit board missing "BOARD.md" "no karr refs and no BOARD.md"
    return 0
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line//$'\r'/}"
    _ack_trim "$line"; t="$REPLY"
    case "$t" in
      '```'*|'~~~'*) [ "$fence" = 1 ] && fence=0 || fence=1; continue ;;
    esac
    [ "$fence" = 0 ] || continue
    # a heading: up to three spaces, 1-6 hashes, then a space (or the line ends)
    t="$line"
    case "$t" in "    "*|"$TAB"*) continue ;; esac
    t="${t#"${t%%[! ]*}"}"
    marks="${t%%[!#]*}"
    case "${#marks}" in 1|2|3|4|5|6) ;; *) continue ;; esac
    t="${t#"$marks"}"
    case "$t" in ''|' '*|"$TAB"*) ;; *) continue ;; esac
    t="$(printf '%s' "$t" | tr -d '*`')"
    _ack_trim "$t"; t="$REPLY"
    t="${t%"${t##*[!#]}"}"
    _ack_trim "$t"; t="$REPLY"
    t="${t#"${t%%[!_]*}"}"; t="${t%"${t##*[!_]}"}"
    _lower "$t"
    case "$REPLY" in
      todo) todo=1 ;;
      "in progress") prog=1 ;;
      review) rev=1 ;;
      done) done_=1 ;;
    esac
  done < "$DIR/BOARD.md"
  [ "$todo" = 1 ] || miss="$miss, Todo"
  [ "$prog" = 1 ] || miss="$miss, In progress"
  [ "$rev" = 1 ] || miss="$miss, Review"
  [ "$done_" = 1 ] || miss="$miss, Done"
  if [ -z "$miss" ]; then
    emit board ok "BOARD.md" ""
  else
    emit board warn "BOARD.md" "no heading for: ${miss#, }"
  fi
}

check_claude_md() {
  local n rx bad=0
  if [ ! -f "$DIR/CLAUDE.md" ]; then
    emit claude-md warn "CLAUDE.md" "not found"
    return 0
  fi
  for n in "${AG_NAMES[@]}"; do
    # the name stands between characters that are no part of a name, or at a line end
    rx="$(printf '%s' "$n" | sed 's/[][\.*^$+?(){}|/]/\\&/g')"
    if ! grep -E -- "(^|[^A-Za-z0-9_-])$rx([^A-Za-z0-9_-]|\$)" "$DIR/CLAUDE.md" >/dev/null 2>&1; then
      emit claude-md warn "CLAUDE.md" "does not name the agent $n"
      bad=1
    fi
  done
  [ "$bad" = 1 ] || emit claude-md ok "CLAUDE.md" ""
}

check_git() {
  if [ -z "$GITTOP" ]; then
    if command -v git >/dev/null 2>&1 && ack_git_refused "$DIR"; then
      emit git missing "." "git cannot read the repository: $REPLY"
    else
      emit git missing "." "not a git repository"
    fi
  elif [ -z "$(git -C "$DIR" remote 2>/dev/null)" ]; then
    emit git warn "." "no remote: the history exists only on this machine"
  else
    emit git ok "." ""
  fi
}

# ---------------------------------------------------------------- ownership

# _owner_agents -> OWNER_AGENTS: declared agent names below the selected directory. This
# deliberately reads only frontmatter.
_owner_agents() {
  local f list
  OWNER_AGENTS=()
  [ -d "$DIR/.claude/agents" ] || return 0
  list="$(find -H "$DIR/.claude/agents" \( -type f -o -type l \) -name '*.md' -print 2>/dev/null | LC_ALL=C sort)"
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    parse_agent "$f"
    [ "$A_FM" = 1 ] && [ "$A_HASNAME" = 1 ] && [ -n "$A_NAME" ] || continue
    OWNER_AGENTS[${#OWNER_AGENTS[@]}]="$A_NAME"
  done <<EOT
$list
EOT
}

# _owner_known NAME: main or one of the selected directory's declared agents.
_owner_known() {
  local name
  [ "$1" = main ] && return 0
  for name in "${OWNER_AGENTS[@]}"; do
    [ "$1" = "$name" ] && return 0
  done
  return 1
}

# _owner_rule_path PATH -> OWNER_RULE_PATH and OWNER_RULE_DIRECTORY. Rules are relative
# forward-slash paths; a trailing slash describes a directory prefix.
_owner_rule_path() {
  local path="$1"
  OWNER_RULE_PATH="" OWNER_RULE_DIRECTORY=0
  case "$path" in
    ''|*"$TAB"*|*$'\n'*|*$'\r'*|/*|[A-Za-z]:*) return 1 ;;
  esac
  case "$path" in
    */) OWNER_RULE_DIRECTORY=1; path="${path%/}" ;;
  esac
  case "$path" in ''|*\\*) return 1 ;; esac
  _collapse_path "$path" || return 1
  [ -n "$REPLY" ] || return 1
  case "$REPLY" in [A-Za-z]:*) return 1 ;; esac
  OWNER_RULE_PATH="$REPLY"
  return 0
}

# _owner_input_path PATH -> OWNER_INPUT_PATH. On Git for Windows and Cygwin a relative
# backslash path follows the same spelling conversion as the command's own path.
_owner_input_path() {
  local path="$1"
  OWNER_INPUT_PATH=""
  case "$path" in *"$TAB"*|*$'\n'*|*$'\r'*) return 1 ;; esac
  _slashes "$path"; path="$REPLY"
  case "$path" in ''|/*|[A-Za-z]:*) return 1 ;; esac
  _collapse_path "$path" || return 1
  [ -n "$REPLY" ] || return 1
  case "$REPLY" in [A-Za-z]:*) return 1 ;; esac
  OWNER_INPUT_PATH="$REPLY"
  return 0
}

# _owner_map_error TEXT -> OWNER_MAP_ERROR: why the selected directory's map is invalid,
# for the caller to report once (owner before any lookup, check as its owners line).
_owner_map_error() {
  OWNER_MAP_ERROR="$1"
  return 1
}

# _owner_read_map -> OWNER_RULE_PATHS, OWNER_RULE_DIRECTORIES, OWNER_RULE_OWNERS, or
# OWNER_MAP_ERROR. A map is validated completely before any requested file is resolved.
_owner_read_map() {
  local map="$DIR/OWNERS" line trimmed path owner i
  OWNER_RULE_PATHS=() OWNER_RULE_DIRECTORIES=() OWNER_RULE_OWNERS=() OWNER_MAP_ERROR=""
  if [ ! -f "$map" ] || [ ! -r "$map" ]; then
    _owner_map_error "is missing or unreadable"
    return 1
  fi
  _owner_agents
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    _ack_trim "$line"; trimmed="$REPLY"
    case "$trimmed" in ''|'#'*) continue ;; esac
    case "$line" in
      *"$TAB"*) path="${line%%"$TAB"*}"; owner="${line#*"$TAB"}" ;;
      *) _owner_map_error "has a malformed row"; return 1 ;;
    esac
    case "$owner" in ''|*"$TAB"*|*$'\n'*|*$'\r'*)
      _owner_map_error "has a malformed row"; return 1 ;;
    esac
    if ! _owner_rule_path "$path"; then
      _owner_map_error "has a path outside the selected directory or not using forward slashes"
      return 1
    fi
    if ! _owner_known "$owner"; then
      _owner_map_error "names an owner that is neither main nor a declared agent"
      return 1
    fi
    for ((i = 0; i < ${#OWNER_RULE_PATHS[@]}; i++)); do
      if [ "${OWNER_RULE_PATHS[$i]}" = "$OWNER_RULE_PATH" ] &&
         [ "${OWNER_RULE_DIRECTORIES[$i]}" = "$OWNER_RULE_DIRECTORY" ]; then
        _owner_map_error "has a duplicate normalized path"
        return 1
      fi
    done
    OWNER_RULE_PATHS[${#OWNER_RULE_PATHS[@]}]="$OWNER_RULE_PATH"
    OWNER_RULE_DIRECTORIES[${#OWNER_RULE_DIRECTORIES[@]}]="$OWNER_RULE_DIRECTORY"
    OWNER_RULE_OWNERS[${#OWNER_RULE_OWNERS[@]}]="$owner"
  done < "$map"
  return 0
}

# _owner_for PATH -> REPLY: exact rules win; otherwise the longest directory prefix wins.
_owner_for() {
  local path="$1" i rule found="" length longest=-1
  for ((i = 0; i < ${#OWNER_RULE_PATHS[@]}; i++)); do
    [ "${OWNER_RULE_DIRECTORIES[$i]}" = 0 ] || continue
    [ "${OWNER_RULE_PATHS[$i]}" = "$path" ] || continue
    REPLY="${OWNER_RULE_OWNERS[$i]}"
    return 0
  done
  for ((i = 0; i < ${#OWNER_RULE_PATHS[@]}; i++)); do
    [ "${OWNER_RULE_DIRECTORIES[$i]}" = 1 ] || continue
    rule="${OWNER_RULE_PATHS[$i]}"
    length=${#rule}
    [ "${#path}" -gt "$length" ] || continue
    [ "${path:0:$length}" = "$rule" ] || continue
    [ "${path:$length:1}" = / ] || continue
    if [ "$length" -gt "$longest" ]; then
      found="${OWNER_RULE_OWNERS[$i]}"
      longest="$length"
    fi
  done
  [ -n "$found" ] || return 1
  REPLY="$found"
  return 0
}

# check_owners: the owners line of check. No OWNERS file is a warning, since teams made
# before the map existed have none; a map that `owner` would refuse is missing.
check_owners() {
  if [ ! -e "$DIR/OWNERS" ] && [ ! -L "$DIR/OWNERS" ]; then
    emit owners warn OWNERS "no OWNERS map: no path has a recorded write owner"
  elif _owner_read_map; then
    emit owners ok OWNERS ""
  else
    emit owners missing OWNERS "The OWNERS map $OWNER_MAP_ERROR. Correct the map and run ack-team check again."
  fi
}

cmd_owner() {
  local directory="." directory_set=0 file shown
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir)
        [ "$directory_set" = 0 ] || usage_err "owner takes --dir only once."
        [ $# -ge 2 ] || usage_err "--dir needs a directory."
        directory="$2"; directory_set=1; shift 2 ;;
      --) shift; break ;;
      -h|--help) _help; exit 0 ;;
      -*) usage_err "unknown option '$1'." ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || usage_err "owner needs at least one file."
  DIR="$(CDPATH= cd -- "$directory" 2>/dev/null && pwd)" && [ -n "$DIR" ] ||
    fail 2 "'$directory' is not a directory." "pass the directory that contains OWNERS."
  DIR="${DIR%/}"
  if ! _owner_read_map; then
    emit owner missing OWNERS "The OWNERS map $OWNER_MAP_ERROR. Correct the map and run ack-team owner again."
    exit "$RC"
  fi
  for file in "$@"; do
    if ! _owner_input_path "$file"; then
      shown="${file//$TAB/ }"; shown="${shown//$'\r'/ }"; shown="${shown//$'\n'/ }"
      emit owner missing "$shown" "The requested path is outside the selected directory or contains a tab or newline. Use a relative file path below the selected directory."
      continue
    fi
    if _owner_for "$OWNER_INPUT_PATH"; then
      emit owner ok "$OWNER_INPUT_PATH" "$REPLY"
    else
      emit owner missing "$OWNER_INPUT_PATH" "No owner is mapped for this path. Add an exact or directory rule to OWNERS."
    fi
  done
  exit "$RC"
}

# ---------------------------------------------------------------- main

cmd_check() {
  [ $# -le 1 ] || usage_err "check takes at most one directory."
  case "${1:-}" in -*) usage_err "unknown option '$1'." ;; esac
  DIR="$(CDPATH= cd -- "${1:-.}" 2>/dev/null && pwd)" && [ -n "$DIR" ] ||
    fail 2 "'${1:-.}' is not a directory." "pass the repository that holds the team."
  DIR="${DIR%/}"
  GITTOP=""
  if command -v git >/dev/null 2>&1; then
    GITTOP="$(git -C "$DIR" rev-parse --show-toplevel 2>/dev/null)"
  fi
  check_briefing
  scan_agents
  check_readonly
  check_rules
  check_board
  check_claude_md
  check_git
  check_owners
  exit "$RC"
}

main() {
  [ $# -gt 0 ] || usage_err "missing subcommand."
  local sub="$1"
  shift
  case "$sub" in
    check) cmd_check "$@" ;;
    owner) cmd_owner "$@" ;;
    -h|--help|help) _help; exit 0 ;;
    *) usage_err "unknown subcommand '$sub'." ;;
  esac
}
# run unless sourced (the tests source the file to try single functions)
if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
