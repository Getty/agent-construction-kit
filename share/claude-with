#!/usr/bin/env bash
# claude-with: start claude with a provider's environment.
#   claude-with [--provider NAME] [--permissions ask|allow|skip] [--print-env] [--] [claude args...]
# Exit codes: 2 usage/definition error, 3 key missing, 4 no claude, 5 proxy unreachable.

# Git for Windows may hand over a backslash path (bash 'D:\x\claude-with').
_slashes() { case "$OSTYPE" in msys*|cygwin*) REPLY="${1//\\//}" ;; *) REPLY="$1" ;; esac; }
_slashes "${BASH_SOURCE[0]}"; _self="$REPLY"
while [ -L "$_self" ]; do
  _slashes "$(readlink "$_self")"; _t="$REPLY"
  case "$_t" in
    /*) _self="$_t" ;;
    *) case "$_self" in */*) _self="${_self%/*}/$_t" ;; *) _self="./$_t" ;; esac ;;
  esac
done
case "$_self" in */*) _dir="${_self%/*}" ;; *) _dir="." ;; esac
ACK_SHARE_DIR="$(cd "$_dir" && pwd)"
# shellcheck source=lib.sh
. "$ACK_SHARE_DIR/lib.sh" || exit 2

_usage="claude-with: usage: claude-with [--provider NAME] [--permissions ask|allow|skip] [--print-env] [--] [claude args...]"
provider="" permissions="ask" print_env=0
while [ $# -gt 0 ]; do
  case "$1" in
    --provider|--permissions)
      if [ $# -lt 2 ]; then
        echo "claude-with: $1 needs a value." >&2
        echo "$_usage" >&2
        exit 2
      fi
      if [ "$1" = --provider ]; then provider="$2"; else permissions="$2"; fi
      if [ -z "$2" ]; then
        echo "claude-with: $1 needs a non-empty value." >&2
        echo "$_usage" >&2
        exit 2
      fi
      shift 2 ;;
    --provider=*|--permissions=*)
      if [ -z "${1#*=}" ]; then
        echo "claude-with: ${1%%=*} needs a non-empty value." >&2
        echo "$_usage" >&2
        exit 2
      fi
      if [ "${1%%=*}" = --provider ]; then provider="${1#*=}"; else permissions="${1#*=}"; fi
      shift ;;
    --provider*|--permissions*)
      echo "claude-with: unknown option '$1' (did you mean --provider NAME or --permissions MODE?)." >&2
      echo "$_usage" >&2
      exit 2 ;;
    --print-env) print_env=1; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

case "$permissions" in
  ask|allow|skip) ;;
  *) echo "claude-with: '$permissions' is not a permission mode." >&2
     echo "claude-with: use --permissions ask, allow or skip." >&2
     exit 2 ;;
esac

ack_paths
exports=""      # NAME=VALUE lines, newline separated
token="" token_from_auth=0 bare=0 mcp=""

if [ -n "$provider" ]; then
  ack_provider_load "$provider" "$ACK_SHARE_DIR" || exit 2
  _ack_build_exports
  exports="$ACK_EXPORTS"
  [ "$ACK_C_BARE" = 1 ] && bare=1
  ack_mcp_path || exit 2
  mcp="$REPLY"

  keyvar="$ACK_C_KEY_VAR"
  case "$keyvar" in
    ''|[0-9]*|*[!A-Za-z0-9_]*) keyvar_ok=0 ;;
    *) keyvar_ok=1 ;;
  esac
  if [ "$ACK_C_KEY_REQUIRED" != 0 ] && [ "$keyvar_ok" = 0 ]; then
    echo "claude-with: provider '$provider' needs a key but has no valid KEY_VAR." >&2
    echo "claude-with: set KEY_VAR=NAME in its definition, or KEY_REQUIRED=0." >&2
    exit 2
  fi
  keyfile="$ACK_C_KEY_FILE"
  if [ -n "$ACK_C_AUTH_TOKEN" ] && [ "$ACK_C_KEY_REQUIRED" = 0 ]; then
    token="$ACK_C_AUTH_TOKEN"; token_from_auth=1
  elif [ "$keyvar_ok" = 1 ]; then
    if [ -n "${!keyvar}" ]; then
      token="${!keyvar}"
    else
      filevar="$ACK_C_KEY_FILE_VAR"
      [ -n "$filevar" ] || filevar="$keyvar"
      if token="$(ack_key_read "$keyfile" "$filevar")" && [ -n "$token" ]; then
        case "$(uname -s)" in
          MSYS*|MINGW*|CYGWIN*) ;;
          *) mode="$(ls -ldL "$keyfile" 2>/dev/null)"
             mode="${mode%% *}"
             if [ "${mode:4:1}" = r ] || [ "${mode:7:1}" = r ]; then
               echo "claude-with: warning: key file '$keyfile' is readable by other users." >&2
               echo "claude-with: restrict it with: chmod 600 '$keyfile'" >&2
             fi ;;
        esac
      else
        token=""
      fi
    fi
  fi
  if [ -z "$token" ] && [ "$ACK_C_KEY_REQUIRED" != 0 ]; then
    if [ "$print_env" = 1 ]; then
      echo "claude-with: warning: no key for provider '$provider' (variable $keyvar is unset and $keyfile has no $ACK_C_KEY_FILE_VAR); showing the dry run anyway." >&2
      token="***missing***"
    else
      echo "claude-with: no key for provider '$provider': variable $keyvar is unset and $keyfile has no $ACK_C_KEY_FILE_VAR." >&2
      echo "claude-with: set $keyvar in your environment or put $keyvar=... into $keyfile." >&2
      exit 3
    fi
  fi
fi

claude_args=()
if [ "$bare" = 1 ]; then
  claude_args+=(--bare)
else
  case "$permissions" in
    allow) claude_args+=(--allow-dangerously-skip-permissions) ;;
    skip) claude_args+=(--dangerously-skip-permissions) ;;
  esac
fi
[ -n "$mcp" ] && claude_args+=(--mcp-config "$mcp")
[ $# -gt 0 ] && claude_args+=("$@")
# the MCP file refers to the key as ${KEY_VAR}; claude hands it on to the server
mcp_key=0
[ -n "$mcp" ] && [ "$token_from_auth" = 0 ] && [ -n "$token" ] && [ "$keyvar_ok" = 1 ] && mcp_key=1

if ! claude_bin="$(ack_find_claude)"; then
  if [ "$print_env" = 1 ]; then
    echo "claude-with: warning: no claude executable found; showing the dry run with the bare name." >&2
    claude_bin=claude
  else
    echo "claude-with: no claude executable found (ACK_CLAUDE_BIN, PATH, ~/.local/bin, ~/bin)." >&2
    echo "claude-with: install Claude Code, or set ACK_CLAUDE_BIN to its path." >&2
    exit 4
  fi
fi

if [ "$print_env" = 1 ]; then
  {
    # what may carry a secret is masked: URL credentials, a token that is not a plain word
    [ -n "$exports" ] && printf '%s' "$exports" | while IFS= read -r l; do
      case "$l" in ANTHROPIC_BASE_URL=*) ack_strip_url "${l#*=}"; l="ANTHROPIC_BASE_URL=$REPLY" ;; esac
      printf 'export %s\n' "$l"
    done
    if [ -n "$provider" ] && [ -n "$token" ]; then
      if [ "$token_from_auth" = 1 ] && ack_is_word "$token"; then printf 'export ANTHROPIC_AUTH_TOKEN=%s\n' "$token"
      else printf 'export ANTHROPIC_AUTH_TOKEN=***\n'; fi
      [ "$mcp_key" = 1 ] && printf 'export %s=***\n' "$keyvar"
    fi
  } | LC_ALL=C sort
  printf 'exec %q' "$claude_bin"
  for a in ${claude_args[@]+"${claude_args[@]}"}; do printf ' %q' "$a"; done
  printf '\n'
  exit 0
fi

if [ -n "$provider" ]; then
  if [ "$ACK_C_PREFLIGHT" = proxy ]; then
    ack_proxy_ensure "$ACK_C_PROXY_PORT" || exit 5
  fi
  # nothing of an outer starter's session (models, window, effort, backend) carries over
  ack_clear_env
  if [ -n "$exports" ]; then
    while IFS= read -r l; do if [ -n "$l" ]; then export "$l"; fi; done <<EOT
$exports
EOT
  fi
  [ -n "$token" ] && export ANTHROPIC_AUTH_TOKEN="$token"
  [ "$mcp_key" = 1 ] && export "$keyvar=$token"
fi
exec "$claude_bin" ${claude_args[@]+"${claude_args[@]}"}
